rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /contacts/{docId} {
      allow read, update, delete: if false;

      allow create: if request.resource.data.keys().hasAll([
            'name',
            'email',
            'projectType',
            'budgetRange',
            'message',
            'verified',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name',
            'email',
            'projectType',
            'budgetRange',
            'message',
            'verified',
            'createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 150
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0
          && request.resource.data.email.size() <= 150
          && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
          && request.resource.data.projectType is string
          && request.resource.data.projectType in [
            'MVP',
            'Enterprise_Web',
            'Cloud_Architecture'
          ]
          && request.resource.data.budgetRange is string
          && request.resource.data.budgetRange in [
            'discovery_phase',
            'scale_phase',
            'enterprise_phase'
          ]
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 2000
          && request.resource.data.verified is bool
          && request.resource.data.verified == false
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    match /likes/{likeId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
