---
import "@fontsource-variable/plus-jakarta-sans";
import "@fontsource-variable/space-grotesk";
import LanguagePicker from "../components/LanguagePicker.astro";

interface Props {
  title?: string;
  lang?: string;
}

const {
  title = "CODEsignLabs | Lead Product & Full-Stack Software Architecture",
  lang,
} = Astro.props;
const currentLocale = lang ?? Astro.currentLocale ?? "en";
const isSpanish = currentLocale === "es";
const siteUrl = Astro.site?.origin ?? "https://codesignlabsca.github.io";
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/es(?=\/|$)/, "").replace(/\/+$/, "");
const enPath = cleanPath || "/";
const esPath = cleanPath
  ? `/es${cleanPath.startsWith("/") ? "" : "/"}${cleanPath}`
  : "/es/";
const enUrl = new URL(enPath, siteUrl).href;
const esUrl = new URL(esPath, siteUrl).href;
const canonicalUrl = new URL(pathname, siteUrl).href;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion-enabled");
      }
    </script>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta
      name="description"
      content={
        isSpanish
          ? "Activos de software de alto rendimiento, ingeniería multiplataforma y arquitectura backend escalable de CODEsignLabs."
          : "High-performance software assets, premium cross-platform engineering, and scalable backend infrastructure by CODEsignLabs."
      }
    />
    <meta
      name="keywords"
      content="CODEsignLabs, Software Architecture, Kotlin Multiplatform, Full-Stack, Supabase, Astro, Flutter"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/iso_codesignlabs.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:title"
      content="CODEsignLabs | Lead Product &amp; Full-Stack Software Architecture"
    />
    <meta
      property="og:description"
      content="We transform complex ideas into highly profitable and scalable software assets."
    />
    <meta property="og:image" content="/svg/iso_codesignlabs_2x.png" />
    <meta property="og:site_name" content="CODEsignLabs" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:title"
      content="CODEsignLabs | Software Architecture"
    />
    <meta
      property="twitter:description"
      content="High-performance software assets and premium cross-platform engineering."
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "@id": "https://codesignlabsca.github.io/#professional-service",
        "name": "CODEsignLabs",
        "legalName": "CODEsignLabs C.A.",
        "url": "https://codesignlabsca.github.io/",
        "logo": "https://codesignlabsca.github.io/svg/iso_codesignlabs_2x.png",
        "image": "https://codesignlabsca.github.io/images/service-sections/The%20Brain%20Behind%20the%20Engineering.webp",
        "description": "Estudio de ingeniería de software de alto rendimiento en Venezuela. Especialistas en arquitectura full-stack, Kotlin Multiplatform, Supabase y desarrollo de activos tecnológicos para clubes y retail.",
        "taxID": "J-40935450-4",
        "priceRange": "$$$",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "VE"
        },
        "founder": {
          "@type": "Person",
          "name": "Jairo Fernando Ramos G.",
          "jobTitle": "Lead Product & Full-Stack Architect"
        },
        "areaServed": [
          {
            "@type": "Country",
            "name": "Venezuela"
          },
          {
            "@type": "Country",
            "name": "United States"
          }
        ],
        "knowsAbout": [
          "Software Architecture",
          "Kotlin Multiplatform",
          "PostgreSQL Multi-Tenant",
          "Supabase",
          "Flutter Development",
          "IoT Automation"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Catálogo de Activos de Software",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "MatchTime Pro — Multi-Tenant Club Ecosystem & IoT"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Smart Retail & Supermarket Systems"
              }
            }
          ]
        }
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
    <LanguagePicker />
  </body>
</html>

<style is:global>
  :root {
    --background: #101010;
    --component-bg: #171717;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
    --font-body: "Plus Jakarta Sans Variable", sans-serif;
    --font-display: "Space Grotesk Variable", sans-serif;
  }

  body {
    font-family: var(--font-body);
  }

  h1,
  h2 {
    font-family: var(--font-display);
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 7rem;
  }

  section[id] {
    position: relative;
  }

  section[id]::before {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    left: 0;
    height: 4px;
    background: linear-gradient(
      90deg,
      transparent,
      #97cc04 18%,
      #d8ff75 50%,
      #97cc04 82%,
      transparent
    );
    box-shadow: 0 0 16px rgb(151 204 4 / 65%);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  section[id].section-transition-active::before {
    animation: section-divider-sweep 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes section-divider-sweep {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }

    18% {
      opacity: 1;
    }

    78% {
      opacity: 0.9;
    }

    100% {
      opacity: 0;
      transform: scaleX(1);
    }
  }

  * {
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }

  html.motion-enabled .display-heading__visual > span {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.35em) rotate(8deg);
    transition:
      opacity 450ms ease,
      transform 550ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--char-index) * 22ms);
  }

  html.motion-enabled
    .display-heading.is-visible
    .display-heading__visual
    > span {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }

  html.motion-enabled .reveal {
    opacity: 0;
    transform: translate3d(0, var(--reveal-offset, 18px), 0)
      scale(var(--reveal-scale, 1));
    transition:
      opacity 550ms ease,
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 650ms ease;
    filter: blur(var(--reveal-blur, 0));
  }

  html.motion-enabled .reveal.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: blur(0);
  }

  html.motion-enabled .reveal-media {
    --reveal-offset: 24px;
    --reveal-scale: 0.96;
    --reveal-blur: 3px;
    overflow: hidden;
  }

  html.motion-enabled .reveal-media__image {
    transform: scale(1.08);
    transition: transform 800ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  html.motion-enabled .reveal-media.is-visible .reveal-media__image {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }

    html.motion-enabled .display-heading__visual > span,
    html.motion-enabled .reveal {
      opacity: 1;
      transform: none;
      transition: none;
      filter: none;
    }

    html.motion-enabled .reveal-media__image {
      transform: none;
    }

    section[id].section-transition-active::before {
      animation: none;
      opacity: 0;
      transform: none;
    }
  }
</style>
