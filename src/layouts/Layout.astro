---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion-enabled");
      }
    </script>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Your Name - Software Developer building interactive and seamless digital experiences with cutting-edge frontend development."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://darkminimal.vercel.app/" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:title" content="Your Name | Software Developer" />
    <meta
      property="og:description"
      content="Portfolio of Your Name, Software Developer specializing in frontend and interactive experiences."
    />
    <meta
      property="og:image"
      content="https://darkminimal.vercel.app/og.image.png"
    />
    <meta property="og:url" content="https://darkminimal.vercel.app" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Your Name Portfolio" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Your Name",
        "alternateName": "Your Name",
        "url": "https://darkminimal.vercel.app",
        "image": "https://darkminimal.vercel.app/og.image.png",
        "sameAs": ["https://github.com", "https://linkedin.com"],
        "jobTitle": "Software Developer",
        "description": "Software Developer building interactive and seamless digital experiences."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --component-bg: #171717;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 7rem;
  }

  section[id] {
    position: relative;
  }

  section[id]::before {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--sec) 18%,
      #eee5ff 50%,
      var(--sec) 82%,
      transparent
    );
    box-shadow: 0 0 12px rgb(164 118 255 / 55%);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  section[id].section-transition-active::before {
    animation: section-divider-sweep 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes section-divider-sweep {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }

    18% {
      opacity: 1;
    }

    78% {
      opacity: 0.9;
    }

    100% {
      opacity: 0;
      transform: scaleX(1);
    }
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }

  html.motion-enabled .display-heading__visual > span {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.35em) rotate(8deg);
    transition:
      opacity 450ms ease,
      transform 550ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--char-index) * 22ms);
  }

  html.motion-enabled
    .display-heading.is-visible
    .display-heading__visual
    > span {
    opacity: 1;
    transform: translateY(0) rotate(0);
  }

  html.motion-enabled .reveal {
    opacity: 0;
    transform: translate3d(0, var(--reveal-offset, 18px), 0)
      scale(var(--reveal-scale, 1));
    transition:
      opacity 550ms ease,
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 650ms ease;
    filter: blur(var(--reveal-blur, 0));
  }

  html.motion-enabled .reveal.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: blur(0);
  }

  html.motion-enabled .reveal-media {
    --reveal-offset: 24px;
    --reveal-scale: 0.96;
    --reveal-blur: 3px;
    overflow: hidden;
  }

  html.motion-enabled .reveal-media__image {
    transform: scale(1.08);
    transition: transform 800ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  html.motion-enabled .reveal-media.is-visible .reveal-media__image {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }

    html.motion-enabled .display-heading__visual > span,
    html.motion-enabled .reveal {
      opacity: 1;
      transform: none;
      transition: none;
      filter: none;
    }

    html.motion-enabled .reveal-media__image {
      transform: none;
    }

    section[id].section-transition-active::before {
      animation: none;
      opacity: 0;
      transform: none;
    }
  }
</style>
