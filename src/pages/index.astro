---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Home from "@/components/home.astro";
import About from "@/components/about.astro";
import Services from "@/components/services.astro";
import Advantages from "@/components/advantages.astro";
import Process from "@/components/process.astro";
import Tools from "@/components/tools.astro";
import Results from "@/components/results.astro";
import Team from "@/components/team.astro";
import Testimonials from "@/components/testimonials.astro";
import Projects from "@/components/projects.astro";
import Contact from "@/components/contact.astro";
import Closing from "@/components/closing.astro";
import Footer from "@/components/footer.astro";
---

<Layout title="Your name">
  <Nav />
  <Home />
  <About />
  <div class="service-section-stack">
    <Services />
    <Advantages />
    <Process />
    <Tools />
    <Results />
    <Team />
  </div>
  <Testimonials />
  <Projects />
  <Contact />
  <Closing />
  <Footer />
</Layout>

<style>
  :global(.service-section-stack) {
    position: relative;
    isolation: isolate;
  }

  :global(.service-section-stack > section) {
    position: sticky;
    top: clamp(5rem, 12vh, 7rem);
    z-index: var(--service-section-layer, 1);
    background: var(--background);
    transform: scale(var(--service-section-scale, 1));
    transform-origin: center top;
    opacity: var(--service-section-opacity, 1);
    will-change: transform, opacity;
  }

  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    :global(.service-section-stack > section) {
      position: relative;
      top: auto;
      transform: none;
      opacity: 1;
      will-change: auto;
    }
  }
</style>

<script>
  const serviceSections = Array.from(
    document.querySelectorAll<HTMLElement>(".service-section-stack > section"),
  );
  let serviceSectionsRafId: number | null = null;

  function updateServiceSections() {
    const shouldStack =
      window.matchMedia("(min-width: 768px)").matches &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const enterPoint = window.innerHeight * 0.88;
    const stackPoint = Math.min(Math.max(window.innerHeight * 0.12, 80), 112);

    serviceSections.forEach((section, index) => {
      const nextSection = serviceSections[index + 1];
      section.style.setProperty("--service-section-layer", String(index + 1));

      if (!shouldStack || !nextSection) {
        section.style.setProperty("--service-section-scale", "1");
        section.style.setProperty("--service-section-opacity", "1");
        return;
      }

      const nextTop = nextSection.getBoundingClientRect().top;
      const progress = Math.min(
        1,
        Math.max(0, (enterPoint - nextTop) / (enterPoint - stackPoint)),
      );

      section.style.setProperty(
        "--service-section-scale",
        String(1 - progress * 0.16),
      );
      section.style.setProperty(
        "--service-section-opacity",
        String(1 - progress),
      );
    });

    serviceSectionsRafId = null;
  }

  function scheduleServiceSectionsUpdate() {
    if (serviceSectionsRafId === null) {
      serviceSectionsRafId = requestAnimationFrame(updateServiceSections);
    }
  }

  window.addEventListener("scroll", scheduleServiceSectionsUpdate, {
    passive: true,
  });
  window.addEventListener("resize", scheduleServiceSectionsUpdate, {
    passive: true,
  });
  updateServiceSections();
</script>
