---
import AnimatedHeading from "./AnimatedHeading.astro";

const principles = [
  {
    title: "AI-Driven Engineering",
    description:
      "Assisted programming using Argon in Antigravity, GitHub Copilot, and Gemini to maximize development speed.",
  },
  {
    title: "High-Fidelity UI/UX",
    description:
      "Modular prototyping structured in Figma according to the Stitch standard, designed for high-conversion interfaces.",
  },
];
---

<section
  id="tools"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading
      eyebrow="Harnessing Cutting-Edge"
      title="Advanced tools and technologies"
    />

    <div class="mb-8 grid gap-5 md:grid-cols-[1fr_0.34fr]">
      <figure class="reveal reveal-media overflow-hidden rounded-2xl">
        <img
          src="/images/presentation/tools-workflow.webp"
          alt="Hands-on collaboration around a development workstation"
          class="reveal-media__image h-52 w-full object-cover md:h-64"
          width="1000"
          height="253"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="reveal reveal-media overflow-hidden rounded-2xl">
        <img
          src="/images/presentation/tools-team.webp"
          alt="A team reviewing work together"
          class="reveal-media__image h-52 w-full object-cover md:h-64"
          width="520"
          height="481"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {principles.map((principle, index) => (
        <article class="approach-card reveal relative overflow-hidden rounded-2xl border border-[var(--white-icon-tr)] p-6 md:p-8">
          <span class="approach-card__number" aria-hidden="true">
            0{index + 1}
          </span>
          <h3 class="relative text-2xl font-medium">{principle.title}</h3>
          <p class="relative mt-4 leading-relaxed text-[var(--white-icon)]">
            {principle.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .approach-card {
    background: linear-gradient(145deg, #a476ff12, #1414149c 65%);
  }

  .approach-card__number {
    position: absolute;
    top: -1.5rem;
    right: 0.75rem;
    color: #a476ff15;
    font-size: 7rem;
    font-weight: 600;
    line-height: 1;
    transition:
      color 300ms ease,
      transform 300ms ease;
  }

  .approach-card:hover .approach-card__number {
    color: #a476ff30;
    transform: translateY(0.25rem);
  }
</style>
