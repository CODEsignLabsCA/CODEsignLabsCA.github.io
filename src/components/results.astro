---
import AnimatedHeading from "./AnimatedHeading.astro";

const outcomeGroups = [
  {
    title: "Enhanced Operational",
    outcomes: [
      {
        title: "Advanced Automation",
        description:
          "Drastic reduction in operational costs through workflows and tool integration.",
      },
      {
        title: "Margin Efficiency",
        description:
          "Lower technical expenditure translates directly into a higher corporate profit margin.",
      },
    ],
  },
  {
    title: "Driving Revenue & New Business",
    outcomes: [
      {
        title: "+30% Average Revenue",
        description:
          "Design and implementation of new transactional channels and active monetization strategies.",
      },
      {
        title: "Consistent Cash Flow",
        description:
          "Automated cross-selling funnels and multi-tenant platforms that transform code into a profitable asset.",
      },
    ],
  },
];
---

<section
  id="results"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading
      eyebrow="Measurable success"
      title="Measurable success through solutions"
    />

    <div class="grid items-start gap-8 md:grid-cols-[0.8fr_1.2fr]">
      <figure class="reveal reveal-media slide-diamond overflow-hidden">
        <img
          src="/images/presentation/results-engineering.webp"
          alt="An engineer reviewing code on a computer"
          class="reveal-media__image aspect-square w-full object-cover"
          width="780"
          height="780"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="grid gap-8 sm:grid-cols-2">
        {outcomeGroups.map((group) => (
          <div class="outcome-group">
            <h3 class="mb-4 text-2xl font-medium">{group.title}</h3>
            <div class="grid gap-4">
              {group.outcomes.map((outcome, index) => (
                <article class="outcome-card reveal">
                  <span class="outcome-card__index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h4 class="text-xl font-medium text-[var(--sec)]">
                    {outcome.title}
                  </h4>
                  <p class="mt-4 leading-relaxed text-[var(--white-icon)]">
                    {outcome.description}
                  </p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .slide-diamond {
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  .outcome-group {
    display: grid;
    align-content: start;
    gap: 0.3rem;
  }

  .outcome-group > h3 {
    min-height: 3.5rem;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.25;
  }

  .outcome-card {
    position: relative;
    display: flex;
    min-height: 12.5rem;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 1.25rem;
    background:
      radial-gradient(
        ellipse at 100% 0%,
        rgb(164 118 255 / 13%),
        transparent 58%
      ),
      var(--component-bg);
    transition:
      border-color 250ms ease,
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .outcome-card:hover {
    transform: translateY(-4px);
    border-color: #a476ff80;
    box-shadow: 0 18px 40px rgb(0 0 0 / 22%);
  }

  .outcome-card__index {
    position: absolute;
    top: 1.1rem;
    right: 1.25rem;
    color: rgb(164 118 255 / 70%);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
  }

  .outcome-card > p {
    font-size: 0.9rem;
  }

  @media (max-width: 767px) {
    .outcome-group > h3 {
      min-height: auto;
    }

    .outcome-card {
      min-height: 10.5rem;
    }
  }
</style>
