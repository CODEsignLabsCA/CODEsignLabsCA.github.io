---
import AnimatedHeading from "./AnimatedHeading.astro";

const isSpanish = Astro.currentLocale === "es";
const outcomeGroups = [
  {
    title: isSpanish ? "Operaciones optimizadas" : "Enhanced Operational",
    outcomes: [
      {
        title: isSpanish ? "Automatización avanzada" : "Advanced Automation",
        description:
          isSpanish
            ? "Reducción significativa de los costos operativos mediante flujos de trabajo e integración de herramientas."
            : "Drastic reduction in operational costs through workflows and tool integration.",
      },
      {
        title: isSpanish ? "Eficiencia de márgenes" : "Margin Efficiency",
        description:
          isSpanish
            ? "Un menor gasto técnico se traduce directamente en un mayor margen de beneficio empresarial."
            : "Lower technical expenditure translates directly into a higher corporate profit margin.",
      },
    ],
  },
  {
    title: isSpanish ? "Impulso de ingresos y nuevos negocios" : "Driving Revenue & New Business",
    outcomes: [
      {
        title: isSpanish ? "+30 % de ingresos promedio" : "+30% Average Revenue",
        description:
          isSpanish
            ? "Diseño e implementación de nuevos canales transaccionales y estrategias activas de monetización."
            : "Design and implementation of new transactional channels and active monetization strategies.",
      },
      {
        title: isSpanish ? "Flujo de caja constante" : "Consistent Cash Flow",
        description:
          isSpanish
            ? "Embudos automatizados de venta cruzada y plataformas multi-tenant que convierten el código en un activo rentable."
            : "Automated cross-selling funnels and multi-tenant platforms that transform code into a profitable asset.",
      },
    ],
  },
];
---

<section
  id="results"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading
      eyebrow={isSpanish ? "Éxito medible" : "Measurable success"}
      title={isSpanish ? "Resultados medibles a través de soluciones" : "Measurable success through solutions"}
    />

    <div class="results-layout">
      <figure class="results-image reveal reveal-media overflow-hidden rounded-2xl">
        <img
          src="/images/service-sections/Measurable%20Success%20Through%20Solutions.webp"
          alt={isSpanish ? "Ingeniero supervisando paneles de rendimiento" : "An engineer monitoring performance dashboards"}
          class="reveal-media__image aspect-square w-full object-cover"
          width="622"
          height="622"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="results-cards">
        {outcomeGroups.map((group, index) => (
          <article class="outcome-card reveal" style={`--card-index: ${index}`}>
            <span class="outcome-card__index" aria-hidden="true">
              0{index + 1}
            </span>
            <h3 class="relative text-2xl font-medium">{group.title}</h3>
            <div class="relative mt-5 grid gap-5">
              {group.outcomes.map((outcome) => (
                <div>
                  <h4 class="text-lg font-medium text-[var(--white)]">
                    {outcome.title}
                  </h4>
                  <p class="mt-2 leading-relaxed text-[var(--white-icon)]">
                    {outcome.description}
                  </p>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .results-layout {
    display: grid;
    align-items: start;
    gap: 1.5rem;
  }

  .results-image {
    width: min(100%, 28rem);
    margin: 0 auto;
  }

  .results-cards {
    display: grid;
    gap: 1rem;
  }

  .outcome-card.reveal {
    transition-delay: calc(var(--card-index) * 180ms);
  }

  .outcome-card {
    position: relative;
    overflow: hidden;
    padding: 1.5rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 1rem;
    background: linear-gradient(145deg, #a476ff12, #1414149c 65%);
    transition:
      border-color 250ms ease,
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .outcome-card p {
    font-size: 0.9375rem;
  }

  .outcome-card__index {
    position: absolute;
    top: -1.5rem;
    right: 0.75rem;
    color: #a476ff15;
    font-size: 7rem;
    font-weight: 600;
    line-height: 1;
  }

  @media (min-width: 1024px) {
    .results-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: stretch;
    }

    .results-image {
      width: 100%;
      margin: 0;
    }

    .results-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-self: stretch;
    }
  }

  .outcome-card:hover {
    transform: translateY(-4px);
    border-color: #a476ff80;
    box-shadow: 0 18px 40px rgb(0 0 0 / 22%);
  }

  @media (prefers-reduced-motion: reduce) {
    .outcome-card.reveal {
      transition-delay: 0ms;
    }
  }
</style>
