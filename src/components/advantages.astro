---
const advantages = [
  {
    title: "Multiplatform Development",
    description: "High-fidelity native and hybrid solutions.",
  },
  {
    title: "Time-to-Market",
    description: "AI-assisted code automation.",
  },
];
---

<section
  id="advantages"
  class="advantages-section scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <span class="advantages-dots advantages-dots--top" aria-hidden="true"></span>
  <span
    class="advantages-dots advantages-dots--bottom"
    aria-hidden="true"
  ></span>
  <div class="advantages-layout">
    <div class="advantages-heading">
      <h2
        class="advantages-title display-heading"
        aria-label="Discover the key advantages"
      >
        <span class="display-heading__visual" aria-hidden="true">
          {Array.from("DISCOVER THE KEY").map((character, index) =>
            character === " " ? (
              " "
            ) : (
              <span style={`--char-index: ${index}`}>{character}</span>
            ),
          )}
          <br />
          {Array.from("ADVANTAGES").map((character, index) => (
            <span style={`--char-index: ${index + 17}`}>{character}</span>
          ))}
        </span>
      </h2>
    </div>

    <article class="advantages-core rounded-2xl">
      <h3>Core Advantages</h3>
      <div class="grid gap-5">
        {advantages.map((advantage) => (
          <p>
            <strong class="text-[var(--white)]">{advantage.title}:</strong>{" "}
            {advantage.description}
          </p>
        ))}
      </div>
    </article>

    <figure class="advantages-primary advantage-artwork advantage-artwork--primary">
      <img
        src="/images/service-sections/Discover the Key Advantages_1.webp"
        alt="A software developer working at a laptop inside a neon diamond frame"
        class="h-auto w-full object-contain"
        width="583"
        height="583"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="advantages-description reveal">
      <p>
        Software is the financial engine of your organization. We structure
        databases in PostgreSQL and MySQL—powered by Supabase and Firebase—and
        analyze consumption patterns in real time to unlock new recurring
        revenue streams.
      </p>
    </div>

    <figure class="advantages-secondary advantage-artwork advantage-artwork--secondary">
      <img
        src="/images/service-sections/Discover the Key Advantages_2.webp"
        alt="A developer in a green shirt reviewing software architecture on a monitor"
        class="h-auto w-full object-contain"
        width="356"
        height="331"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .advantages-section {
    min-height: 34rem;
    padding-block: 5rem;
  }

  .advantages-layout {
    position: relative;
    display: grid;
    width: min(100%, 56.75rem);
    min-height: 24rem;
    margin-inline: auto;
    align-items: start;
    column-gap: 0.75rem;
    row-gap: 1rem;
  }

  @media (min-width: 768px) {
    .advantages-layout {
      transform: translateX(2rem);
    }
  }

  .advantages-primary,
  .advantages-secondary {
    margin: 0;
  }

  .advantages-primary img,
  .advantages-secondary img {
    display: block;
  }

  .advantages-title {
    margin: 0;
    color: #fff;
    font-family: "Arial Narrow", "Roboto Condensed", Impact, sans-serif;
    font-size: clamp(2.1rem, 4vw, 2.65rem);
    font-stretch: condensed;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.14;
    text-transform: uppercase;
  }

  .advantages-core {
    padding: 1rem 2rem 1.5rem;
    background: #29383d;
    color: #f3f3f3;
  }

  .advantages-core h3 {
    margin-bottom: 0.65rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .advantages-core p,
  .advantages-description {
    color: var(--white-icon);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .advantages-description {
    padding: 0 1.25rem 0 2.25rem;
  }

  .advantages-dots {
    position: absolute;
    width: 4.5rem;
    height: 2.75rem;
    background-image: radial-gradient(circle, #f3f3f3 1.6px, transparent 1.8px);
    background-size: 0.625rem 0.625rem;
    pointer-events: none;
  }

  .advantages-dots--top {
    top: 3.8rem;
    right: 0;
  }

  .advantages-dots--bottom {
    bottom: 2.4rem;
    left: -3.375rem;
  }

  .advantage-artwork.motion-ready img {
    will-change: clip-path, opacity, transform;
  }

  .advantage-artwork--primary.is-visible img {
    animation: advantage-primary-enter 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .advantage-artwork--primary.is-hidden img {
    animation: advantage-primary-exit 650ms cubic-bezier(0.4, 0, 0.8, 0.3) both;
  }

  .advantage-artwork--secondary.is-visible img {
    animation: advantage-secondary-enter 800ms 120ms
      cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .advantage-artwork--secondary.is-hidden img {
    animation: advantage-secondary-exit 600ms cubic-bezier(0.4, 0, 0.8, 0.3)
      both;
  }

  @keyframes advantage-primary-enter {
    from {
      clip-path: circle(0 at 50% 50%);
      opacity: 0;
      transform: rotate(-8deg) scale(0.86);
    }

    to {
      clip-path: circle(75% at 50% 50%);
      opacity: 1;
      transform: rotate(0) scale(1);
    }
  }

  @keyframes advantage-primary-exit {
    from {
      clip-path: circle(75% at 50% 50%);
      opacity: 1;
      transform: rotate(0) scale(1);
    }

    to {
      clip-path: circle(0 at 50% 50%);
      opacity: 0;
      transform: rotate(8deg) scale(0.86);
    }
  }

  @keyframes advantage-secondary-enter {
    from {
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      transform: translateY(1.25rem);
    }

    to {
      clip-path: inset(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes advantage-secondary-exit {
    from {
      clip-path: inset(0);
      opacity: 1;
      transform: translateY(0);
    }

    to {
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @media (min-width: 768px) {
    .advantages-layout {
      grid-template-columns: 352fr 334fr 198fr;
      grid-template-rows: 11.25rem 11rem;
    }

    .advantages-heading {
      grid-column: 1;
      grid-row: 1;
      padding-top: 0.25rem;
    }

    .advantages-core {
      grid-column: 2;
      grid-row: 1;
    }

    .advantages-primary {
      z-index: 1;
      grid-column: 1;
      grid-row: 2;
      width: min(100%, 20rem);
      margin: -7.25rem 0 0 -0.5rem;
    }

    .advantages-description {
      grid-column: 2;
      grid-row: 2;
      padding-top: 0.125rem;
    }

    .advantages-secondary {
      grid-column: 3;
      grid-row: 2;
      width: 100%;
      margin: -4.75rem 0 0 -0.75rem;
    }
  }

  @media (max-width: 767px) {
    .advantages-section {
      min-height: 0;
    }

    .advantages-layout {
      gap: 1.5rem;
      transform: none;
    }

    .advantages-primary {
      grid-row: 3;
      width: min(100%, 24rem);
      justify-self: center;
    }

    .advantages-heading {
      grid-row: 1;
    }

    .advantages-core {
      grid-row: 2;
    }

    .advantages-description {
      grid-row: 4;
    }

    .advantages-secondary {
      grid-row: 5;
      width: min(65%, 15rem);
      justify-self: end;
      margin-top: -1rem;
    }

    .advantages-dots--top {
      top: 2rem;
      right: 1rem;
    }

    .advantages-dots--bottom {
      bottom: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .advantage-artwork img {
      animation: none !important;
      clip-path: none;
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
</style>

<script>
  const advantageArtwork = Array.from(
    document.querySelectorAll<HTMLElement>(".advantage-artwork"),
  );
  const advantagesSection = document.querySelector<HTMLElement>("#advantages");
  let advantagesAreStacking =
    advantagesSection?.classList.contains("section-is-stacking") ?? false;
  const reduceArtworkMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const usesStickySections =
    window.matchMedia("(min-width: 768px)").matches && !reduceArtworkMotion;

  function setArtworkVisibility(isVisible: boolean) {
    advantageArtwork.forEach((artwork) => {
      artwork.classList.toggle("is-visible", isVisible);
      artwork.classList.toggle("is-hidden", !isVisible);
    });
  }

  if (
    !reduceArtworkMotion &&
    "IntersectionObserver" in window &&
    advantageArtwork.length
  ) {
    advantageArtwork.forEach((artwork) =>
      artwork.classList.add("motion-ready"),
    );

    const artworkObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (usesStickySections) {
            if (!entry.isIntersecting) return;
            artworkObserver.unobserve(entry.target);
            if (!advantagesAreStacking) {
              entry.target.classList.add("is-visible");
              entry.target.classList.remove("is-hidden");
            }
            return;
          }

          if (advantagesAreStacking) return;
          entry.target.classList.toggle("is-visible", entry.isIntersecting);
          entry.target.classList.toggle("is-hidden", !entry.isIntersecting);
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );

    advantageArtwork.forEach((artwork) => artworkObserver.observe(artwork));
  }

  advantagesSection?.addEventListener("section-stack-state", (event) => {
    const stackEvent = event as CustomEvent<{ isStacking: boolean }>;
    if (reduceArtworkMotion) return;
    advantagesAreStacking = stackEvent.detail.isStacking;
    setArtworkVisibility(!stackEvent.detail.isStacking);
  });
</script>
