---
import ContactDiagnostic from "../React/ContactDiagnostic";

const isSpanish = Astro.currentLocale === "es";
---

<section id="contact" class="w-full border-t border-[#ffffff10] py-16 md:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="contact-layout">
      <div class="contact-intro text-[var(--white-icon)]">
        <h2 class="mb-2 text-lg text-[var(--sec)] shiny-sec">
          {isSpanish ? "Hablemos" : "Let's talk"}
        </h2>
        <h3 class="mb-6 font-display text-4xl font-medium text-[var(--white)] md:text-5xl">
          {isSpanish ? "Contacto" : "Contact"}
        </h3>
        <ContactDiagnostic client:load isSpanish={isSpanish} />
        <div class="mt-6 space-y-3 border-t border-zinc-800/80 pt-6 font-body">
          <a
            href="https://wa.link/ya7q1a"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-sm text-zinc-400 transition-colors hover:text-[#CCFF00]"
          >
            {isSpanish ? "Conéctese por WhatsApp" : "Connect via WhatsApp"} &rarr;
          </a>
        </div>
      </div>

      <div class="contact-form-panel flex h-full flex-col justify-center space-y-6 text-left">
        <div class="border-l-4 border-[#CCFF00] pl-4 font-body">
          <p class="text-xs font-semibold uppercase tracking-widest text-zinc-400">
            {isSpanish ? "Valoración empresarial" : "Business Valuation"}
          </p>
          <h3 class="mt-2 text-lg font-bold leading-relaxed text-white md:text-xl">
            {isSpanish ? (
              <>
                Crear software es fácil. Generar{" "}
                <span class="text-[#CCFF00]">valor empresarial</span> real y abrir{" "}
                <span class="text-[#CCFF00]">nuevas fuentes de ingresos</span> no lo es.
              </>
            ) : (
              <>
                Building software is easy. Creating real{" "}
                <span class="text-[#CCFF00]">business value</span> and unlocking{" "}
                <span class="text-[#CCFF00]">new revenue streams</span> is not.
              </>
            )}
          </h3>
        </div>

        <div class="py-2">
          <h2 class="font-display text-4xl font-black leading-none tracking-tight text-white md:text-5xl">
            {isSpanish ? "¿LISTO PARA " : "READY TO "}
            <span class="text-[#CCFF00]">{isSpanish ? "ESCALAR?" : "SCALE?"}</span>
          </h2>
          <p class="mt-3 max-w-md font-body text-sm text-zinc-400">
            {isSpanish
              ? "Construyamos hoy el futuro de su producto digital. Envíe un mensaje y recibirá un diagnóstico técnico en menos de 24 horas."
              : "Let's build the future of your digital product today. Leave a message to get a technical diagnostic in less than 24 hours."}
          </p>
        </div>

        <div class="border-t border-zinc-800/80 pt-4 font-body">
          <p class="text-xs font-medium text-zinc-500">
            {isSpanish ? "¿Prefiere agendar directamente?" : "Prefer direct scheduling?"}
          </p>
          <button
            type="button"
            data-cal-popup
            class="group mt-1.5 inline-flex items-center gap-2 text-left text-sm font-semibold text-[#CCFF00] transition-colors hover:text-white"
          >
            <span>
              {isSpanish
                ? "Agende una llamada de exploración de 15 min en Cal.com"
                : "Book a 15-min discovery call via Cal.com"}
            </span>
            <span class="transform transition-transform group-hover:translate-x-1" aria-hidden="true">
              &rarr;
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type CalFunction = ((...args: unknown[]) => void) & {
    loaded?: boolean;
    ns?: Record<string, CalFunction>;
    q?: unknown[][];
  };

  declare global {
    interface Window {
      Cal?: CalFunction;
    }
  }

  const namespace = "contact";
  const calLink = "codesignlabs/15min";

  function initializeCal(): CalFunction {
    const calWindow = window as Window & { Cal?: CalFunction };
    if (calWindow.Cal) return calWindow.Cal;

    const cal = function (...args: unknown[]) {
      const instance = cal as CalFunction;
      const enqueue = (target: CalFunction, values: unknown[]) => {
        target.q = target.q ?? [];
        target.q.push(values);
      };

      if (!instance.loaded) {
        instance.ns = {};
        instance.q = [];
        const script = document.createElement("script");
        script.src = "https://app.cal.com/embed/embed.js";
        script.async = true;
        script.onerror = () => console.error("Failed to load the Cal.com embed.");
        document.head.appendChild(script);
        instance.loaded = true;
      }

      if (args[0] === "init") {
        const calNamespace = args[1];
        if (typeof calNamespace === "string") {
          const api = function (...namespaceArgs: unknown[]) {
            enqueue(api as CalFunction, namespaceArgs);
          } as CalFunction;
          api.q = [];
          instance.ns![calNamespace] = api;
          enqueue(instance, ["initNamespace", calNamespace]);
          return;
        }
      }

      enqueue(instance, args);
    } as CalFunction;

    calWindow.Cal = cal;
    return cal;
  }

  document.querySelectorAll<HTMLButtonElement>("[data-cal-popup]").forEach((button) => {
    button.addEventListener("click", () => {
      const Cal = initializeCal();
      Cal("init", namespace, { origin: "https://app.cal.com" });
      Cal("ui", {
        styles: { branding: { brandColor: "#CCFF00" } },
      });
      Cal.ns?.[namespace]("modal", { calLink });
    });
  });
</script>

<style is:global>
  .contact-layout {
    display: grid;
    align-items: stretch;
    gap: 2rem;
  }

  .contact-intro,
  .contact-form-panel {
    min-width: 0;
  }

  .contact-diagnostic {
    position: relative;
    min-height: 24rem;
    color: var(--white);
  }

  .contact-diagnostic__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-diagnostic__qualifier {
    min-width: 0;
    border: 0;
    padding: 0;
  }

  .contact-diagnostic__qualifier legend,
  .contact-diagnostic__field > span {
    display: block;
    margin-bottom: 0.45rem;
    color: #b6b6bd;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .contact-diagnostic__chips {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    padding: 0.1rem 0 0.3rem;
    scrollbar-width: thin;
  }

  .contact-diagnostic__chip {
    flex: 0 0 auto;
    min-height: 2.25rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 9999px;
    background: #1414149c;
    color: #d3d3d8;
    font-size: 0.72rem;
    line-height: 1.2;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .contact-diagnostic__chip:hover {
    border-color: #ccff00;
  }

  .contact-diagnostic__chip.is-selected {
    border-color: #ccff00;
    background: #ccff00;
    color: #121212;
  }

  .contact-diagnostic__chip:focus-visible,
  .contact-diagnostic__field input:focus-visible,
  .contact-diagnostic__field textarea:focus-visible {
    outline: 2px solid #ccff00;
    outline-offset: 2px;
  }

  .contact-diagnostic__field input,
  .contact-diagnostic__field textarea {
    display: block;
    width: 100%;
    border: 1px solid var(--white-icon-tr);
    border-radius: 0.5rem;
    background: #1414149c;
    padding: 0.65rem 0.85rem;
    color: var(--white);
    font-size: 0.85rem;
  }

  .contact-diagnostic__field textarea {
    resize: vertical;
  }

  .contact-diagnostic__field input::placeholder,
  .contact-diagnostic__field textarea::placeholder {
    color: #777780;
  }

  .contact-diagnostic__error {
    color: #ff9a9a;
    font-size: 0.82rem;
  }

  .contact-diagnostic__loader {
    width: 1rem;
    height: 1rem;
    border: 2px solid rgb(204 255 0 / 35%);
    border-top-color: #ccff00;
    border-radius: 50%;
    animation: contact-spin 700ms linear infinite;
  }

  .contact-diagnostic__success {
    top: 50%;
    width: 100%;
    color: var(--white);
    font-size: 1rem;
    line-height: 1.7;
    transform: translateY(-50%);
  }

  .contact-submit {
    position: relative;
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    align-self: center;
    overflow: hidden;
    background-color: transparent;
    color: #ccff00;
    box-shadow: 0 0 0 2px #ccff00;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease,
      opacity 200ms ease;
  }

  .contact-submit:hover:not(:disabled) {
    background: #ccff00;
    color: #121212;
    box-shadow: 0 0 0 2px #ccff00;
  }

  .contact-submit:focus-visible {
    outline: 2px solid #ccff00;
    outline-offset: 4px;
  }

  .contact-submit:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  @keyframes contact-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (min-width: 768px) {
    .contact-layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-intro {
      padding: 1.5rem;
      background: #101010;
    }

    .contact-form-panel {
      padding-top: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-diagnostic__chip,
    .contact-submit {
      transition: none;
    }

    .contact-diagnostic__loader {
      animation-duration: 1400ms;
    }
  }
</style>
