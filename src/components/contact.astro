---
const isSpanish = Astro.currentLocale === "es";
---

<section id="contact" class="w-full border-t border-[#ffffff10] py-16 md:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="contact-layout">
      <div class="contact-intro text-[var(--white-icon)]">
        <h2 class="mb-2 text-lg text-[var(--sec)] shiny-sec">
          {isSpanish ? "Hablemos" : "Let's talk"}
        </h2>
        <h3 class="mb-6 text-4xl font-medium text-[var(--white)] md:text-5xl">
          {isSpanish ? "Contacto" : "Contact"}
        </h3>
        <form
          id="contact-form"
          data-locale={isSpanish ? "es" : "en"}
          class="flex flex-col gap-4"
        >
          <input
            type="text"
            name="from_name"
            placeholder={isSpanish ? "Nombre" : "Name"}
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <input
            type="email"
            name="reply_to"
            placeholder={isSpanish ? "Correo electrónico" : "Email"}
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <input
            type="text"
            name="company"
            placeholder={isSpanish ? "Empresa / Asunto" : "Company / Subject"}
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <textarea
            name="message"
            placeholder={isSpanish ? "Mensaje" : "Message"}
            rows="6"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none"
          ></textarea>
          <button
            type="submit"
            class="contact-submit rounded-full border-4 border-transparent px-9 py-4 font-semibold"
          >
            <svg
              class="contact-submit-arrow contact-submit-arrow--incoming"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M16.17 11 10.81 5.64l1.41-1.42L20 12l-7.78 7.78-1.41-1.42L16.17 13H4v-2h12.17Z"></path>
            </svg>
            <span class="contact-submit-label">
              {isSpanish ? "CONSTRUYAMOS EL FUTURO" : "LET'S BUILD THE FUTURE"}
            </span>
            <span class="contact-submit-circle" aria-hidden="true"></span>
            <svg
              class="contact-submit-arrow contact-submit-arrow--outgoing"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M16.17 11 10.81 5.64l1.41-1.42L20 12l-7.78 7.78-1.41-1.42L16.17 13H4v-2h12.17Z"></path>
            </svg>
          </button>
        </form>
        <div class="mt-6 space-y-3 border-t border-zinc-800/80 pt-6">
          <a
            href="https://wa.link/ya7q1a"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-sm text-zinc-400 transition-colors hover:text-[#97CC04]"
          >
            {isSpanish ? "Conéctese por WhatsApp" : "Connect via WhatsApp"} &rarr;
          </a>
        </div>
        <div
          id="form-message"
          role="status"
          aria-live="polite"
          class="hidden justify-center items-center mt-4 text-[var(--white)] text-lg"
        >
          {isSpanish ? "✅ Gracias por su mensaje." : "✅ Thank you for your message!"}
        </div>
      </div>

      <div class="contact-form-panel flex h-full flex-col justify-center space-y-6 text-left">
        <div class="border-l-4 border-[#97CC04] pl-4">
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-zinc-400">
            {isSpanish ? "Valoración empresarial" : "Business Valuation"}
          </p>
          <h3 class="mt-2 text-lg font-bold leading-relaxed text-white md:text-xl">
            {isSpanish
              ? "Crear software es fácil. Generar valor empresarial real y abrir nuevas fuentes de ingresos no lo es."
              : "Building software is easy. Creating real business value and unlocking new revenue streams is not."}
          </h3>
        </div>

        <div class="py-2">
          <h2 class="text-4xl font-black leading-none tracking-tight text-white md:text-5xl">
            {isSpanish ? "¿LISTO PARA " : "READY TO "}
            <span class="text-[#97CC04]">{isSpanish ? "ESCALAR?" : "SCALE?"}</span>
          </h2>
          <p class="mt-3 max-w-md text-sm text-zinc-400">
            {isSpanish
              ? "Construyamos hoy el futuro de su producto digital. Envíe un mensaje y recibirá un diagnóstico técnico en menos de 24 horas."
              : "Let's build the future of your digital product today. Leave a message to get a technical diagnostic in less than 24 hours."}
          </p>
        </div>

        <div class="border-t border-zinc-800/80 pt-4">
          <p class="text-xs font-medium text-zinc-500">
            {isSpanish ? "¿Prefiere agendar directamente?" : "Prefer direct scheduling?"}
          </p>
          <a
            href="https://cal.com"
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-1.5 inline-flex items-center gap-2 text-sm font-semibold text-[#97CC04] transition-colors hover:text-white"
          >
            <span>
              {isSpanish
                ? "Agende una llamada de exploración de 15 min en Cal.com"
                : "Book a 15-min discovery call via Cal.com"}
            </span>
            <span class="transform transition-transform group-hover:translate-x-1">
              &rarr;
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-layout {
    display: grid;
    align-items: stretch;
    gap: 2rem;
  }

  .contact-intro,
  .contact-form-panel {
    min-width: 0;
  }

  .contact-submit {
    position: relative;
    display: flex;
    align-items: center;
    gap: 4px;
    overflow: hidden;
    align-self: center;
    background-color: transparent;
    color: #97cc04;
    box-shadow: 0 0 0 2px #97cc04;
    cursor: pointer;
    transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .contact-submit-label {
    position: relative;
    z-index: 1;
    white-space: nowrap;
    transform: translateX(-12px);
    transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .contact-submit-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: #97cc04;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .contact-submit-arrow {
    position: absolute;
    z-index: 9;
    width: 24px;
    fill: #97cc04;
    transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .contact-submit-arrow--incoming {
    left: -25%;
  }

  .contact-submit-arrow--outgoing {
    right: 16px;
  }

  .contact-submit:hover {
    color: #151c1e;
    box-shadow: 0 0 0 12px transparent;
  }

  .contact-submit:hover .contact-submit-label {
    transform: translateX(12px);
  }

  .contact-submit:hover .contact-submit-circle {
    opacity: 1;
    width: 220px;
    height: 220px;
  }

  .contact-submit:hover .contact-submit-arrow--incoming {
    left: 16px;
  }

  .contact-submit:hover .contact-submit-arrow--outgoing {
    right: -25%;
  }

  .contact-submit:hover .contact-submit-arrow {
    fill: #151c1e;
  }

  .contact-submit:active {
    transform: scale(0.95);
    box-shadow: 0 0 0 4px #97cc04;
  }

  .contact-submit:focus-visible {
    outline: 2px solid #97cc04;
    outline-offset: 4px;
  }

  .contact-submit:disabled {
    cursor: wait;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-submit,
    .contact-submit-label,
    .contact-submit-circle,
    .contact-submit-arrow {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .contact-layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-intro {
      padding: 1.5rem;
      background: #101010;
    }

    .contact-form-panel {
      padding-top: 0.75rem;
    }
  }
</style>

<script>
  import { addDoc, collection } from "firebase/firestore";
  import { db } from "../firebase";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const formMessage = document.querySelector<HTMLDivElement>("#form-message");

  if (form && formMessage) {
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const submitLabel = submitButton?.querySelector<HTMLElement>(".contact-submit-label");
    const isSpanish = form.dataset.locale === "es";
    const originalButtonText = submitLabel?.textContent?.trim() ?? "";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!submitButton || !submitLabel) {
        console.error("Contact form submit button or label was not found.");
        return;
      }

      const formData = new FormData(form);
      const name = String(formData.get("from_name") ?? "").trim();
      const email = String(formData.get("reply_to") ?? "").trim();
      const company = String(formData.get("company") ?? "").trim();
      const message = String(formData.get("message") ?? "").trim();

      submitButton.disabled = true;
      submitLabel.textContent = isSpanish ? "Enviando..." : "Sending...";

      try {
        await addDoc(collection(db, "contacts"), {
          name,
          email,
          company,
          message,
          createdAt: new Date(),
        });

        form.reset();
        form.style.display = "none";
        formMessage.classList.remove("hidden");
      } catch (error) {
        console.error("Unable to submit contact form to Firestore:", error);
        alert(
          isSpanish
            ? "Hubo un problema al enviar su mensaje. Inténtelo de nuevo más tarde."
            : "There was a problem sending your message. Please try again later.",
        );
        submitButton.disabled = false;
        submitLabel.textContent = originalButtonText;
      }
    });
  }
</script>
