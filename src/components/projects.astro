---
const projectSlots = [
  {
    number: "01",
    type: "Mobile application",
    title: "Mobile app interface",
    layout: "mobile",
  },
  {
    number: "02",
    type: "Web platform",
    title: "Web dashboard interface",
    layout: "dashboard",
  },
  {
    number: "03",
    type: "Backend & integrations",
    title: "Integration workflow interface",
    layout: "workflow",
  },
  {
    number: "04",
    type: "Digital product",
    title: "Digital product interface",
    layout: "product",
  },
];
---

<section
  id="projects"
  class="scroll-mt-28 border-t border-[#ffffff10] py-16 text-[var(--white)] md:py-20"
>
  <div class="mx-auto max-w-6xl">
    <div class="projects-heading">
      <div>
        <p class="mb-2 text-lg text-[var(--sec)] shiny-sec">Selected work</p>
        <h2 class="text-4xl font-medium md:text-5xl">Projects</h2>
      </div>
      <p class="projects-note">
        This portfolio model is ready for real application and system
        screenshots, project details, and verified outcomes.
      </p>
    </div>

    <div class="projects-showcase" data-project-showcase>
      <div class="projects-visual" aria-hidden="true">
        {projectSlots.map((project, index) => (
          <div
            class:list={[
              "project-preview",
              `project-preview--${project.layout}`,
              { "is-active": index === 0 },
            ]}
            data-project-preview={index}
          >
            <div class="preview-window">
              <div class="preview-toolbar">
                <span></span>
                <span></span>
                <span></span>
                <i></i>
              </div>
              <div class="preview-screen">
                <div class="preview-sidebar">
                  <b></b>
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
                <div class="preview-main">
                  <div class="preview-heading">
                    <i></i>
                    <b></b>
                  </div>
                  <div class="preview-panels">
                    <div class="preview-panel preview-panel--large">
                      <i></i>
                      <b></b>
                      <span></span>
                    </div>
                    <div class="preview-panel">
                      <i></i>
                      <b></b>
                    </div>
                    <div class="preview-panel">
                      <i></i>
                      <b></b>
                    </div>
                  </div>
                  <div class="preview-chart">
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                </div>
              </div>
            </div>
            {project.layout === "mobile" && (
              <div class="preview-phone">
                <div></div>
                <b></b>
                <i></i>
                <i></i>
                <span></span>
              </div>
            )}
            <span class="preview-index">{project.number}</span>
          </div>
        ))}
      </div>

      <div class="projects-grid">
        {projectSlots.map((project, index) => (
          <article
            class:list={[
              "project-card",
              "reveal",
              { "is-active": index === 0 },
            ]}
            data-project-card={index}
          >
            <div class="project-card__details">
              <div class="project-card__heading">
                <span class="project-number">{project.number}</span>
                <span class="project-type">{project.type}</span>
              </div>
              <h3>{project.title}</h3>
              <span class="project-pending">CAPTURA PENDIENTE</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const showcases = document.querySelectorAll<HTMLElement>(
    "[data-project-showcase]",
  );

  showcases.forEach((showcase) => {
    const cards = Array.from(
      showcase.querySelectorAll<HTMLElement>("[data-project-card]"),
    );
    const previews = Array.from(
      showcase.querySelectorAll<HTMLElement>("[data-project-preview]"),
    );

    if (!cards.length || cards.length !== previews.length) return;

    const activateProject = (index: number) => {
      cards.forEach((card, cardIndex) => {
        card.classList.toggle("is-active", cardIndex === index);
      });
      previews.forEach((preview, previewIndex) => {
        preview.classList.toggle("is-active", previewIndex === index);
      });
    };

    activateProject(0);

    const observer = new IntersectionObserver(
      (entries) => {
        const activeEntries = entries.filter((entry) => entry.isIntersecting);
        if (!activeEntries.length) return;

        const closestEntry = activeEntries.reduce((closest, entry) => {
          const entryCenter =
            entry.boundingClientRect.top + entry.boundingClientRect.height / 2;
          const closestCenter =
            closest.boundingClientRect.top +
            closest.boundingClientRect.height / 2;

          return Math.abs(entryCenter - window.innerHeight / 2) <
            Math.abs(closestCenter - window.innerHeight / 2)
            ? entry
            : closest;
        });

        const activeIndex = Number(
          closestEntry.target.getAttribute("data-project-card"),
        );
        if (Number.isInteger(activeIndex)) activateProject(activeIndex);
      },
      { rootMargin: "-38% 0px -38% 0px", threshold: 0 },
    );

    cards.forEach((card) => observer.observe(card));
  });
</script>

<style>
  .projects-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .projects-note {
    max-width: 29rem;
    color: var(--white-icon);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .projects-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .projects-visual {
    position: sticky;
    top: 7rem;
    min-width: 0;
    height: min(34rem, 58vh);
    min-height: 22rem;
    overflow: hidden;
    border: 1px solid var(--white-icon-tr);
    border-radius: 1.5rem;
    background: #141318;
    box-shadow: 0 24px 70px rgb(0 0 0 / 24%);
  }

  .projects-grid {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1rem;
  }

  .project-card {
    position: relative;
    min-width: 0;
    min-height: min(42vh, 25rem);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 1.5rem;
    background: #141318;
    opacity: 0.64;
    transition:
      border-color 400ms ease,
      background-color 400ms ease,
      box-shadow 450ms ease,
      opacity 400ms ease;
  }

  .project-card::before {
    position: absolute;
    z-index: -1;
    background: linear-gradient(
      0deg,
      rgb(164 118 255 / 15%),
      rgb(164 118 255 / 5%) 65%,
      transparent
    );
    content: "";
    inset: 0;
    opacity: 0;
    transform: scaleY(0);
    transform-origin: bottom;
    transition:
      opacity 350ms ease,
      transform 550ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project-card.is-active {
    border-color: #a476ff80;
    background-color: #19161f;
    box-shadow: 0 18px 48px rgb(0 0 0 / 22%);
    opacity: 1;
  }

  .project-card.is-active::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .project-preview {
    display: grid;
    position: absolute;
    inset: 0;
    place-items: center;
    overflow: hidden;
    border: 0;
    background:
      radial-gradient(
        ellipse at 70% 20%,
        rgb(164 118 255 / 18%),
        transparent 48%
      ),
      linear-gradient(145deg, #1d1b25, #111);
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition:
      opacity 450ms ease,
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project-preview.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .project-preview.is-active .preview-window {
    transform: perspective(900px) rotateY(0) rotateX(0) scale(1.02);
  }

  .preview-window {
    width: 76%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 0.8rem;
    background: #101013;
    box-shadow: 0 24px 60px rgb(0 0 0 / 35%);
    transform: perspective(900px) rotateY(-7deg) rotateX(3deg);
    transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .preview-toolbar {
    display: flex;
    height: 1.35rem;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
    background: #1c1b20;
  }

  .preview-toolbar > span {
    width: 0.27rem;
    height: 0.27rem;
    border-radius: 50%;
    background: #625e69;
  }

  .preview-toolbar > span:first-child {
    background: #a476ff;
  }

  .preview-toolbar > i {
    width: 30%;
    height: 0.25rem;
    margin-left: 0.5rem;
    border-radius: 1rem;
    background: rgb(255 255 255 / 8%);
  }

  .preview-screen {
    display: grid;
    min-height: 10rem;
    grid-template-columns: 19% 1fr;
  }

  .preview-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem 0.5rem;
    border-right: 1px solid rgb(255 255 255 / 7%);
  }

  .preview-sidebar b,
  .preview-sidebar i,
  .preview-heading i,
  .preview-heading b,
  .preview-panel i,
  .preview-panel b,
  .preview-panel span {
    display: block;
    border-radius: 1rem;
    background: rgb(255 255 255 / 11%);
  }

  .preview-sidebar b {
    width: 70%;
    height: 0.45rem;
    margin-bottom: 0.25rem;
    background: var(--sec);
  }

  .preview-sidebar i {
    width: 85%;
    height: 0.28rem;
  }

  .preview-main {
    padding: 0.85rem;
  }

  .preview-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .preview-heading i {
    width: 35%;
    height: 0.42rem;
    background: rgb(255 255 255 / 55%);
  }

  .preview-heading b {
    width: 18%;
    height: 0.4rem;
    background: rgb(164 118 255 / 75%);
  }

  .preview-panels {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 0.45rem;
  }

  .preview-panel {
    min-height: 2.4rem;
    padding: 0.45rem;
    border: 1px solid rgb(255 255 255 / 7%);
    border-radius: 0.35rem;
    background: #19181e;
  }

  .preview-panel i {
    width: 55%;
    height: 0.25rem;
    margin-bottom: 0.4rem;
    background: rgb(164 118 255 / 65%);
  }

  .preview-panel b {
    width: 75%;
    height: 0.45rem;
    background: rgb(255 255 255 / 22%);
  }

  .preview-panel span {
    width: 45%;
    height: 0.25rem;
    margin-top: 0.35rem;
  }

  .preview-chart {
    display: flex;
    height: 2.8rem;
    align-items: end;
    gap: 0.4rem;
    margin-top: 0.55rem;
    padding: 0 0.35rem;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
  }

  .preview-chart i {
    flex: 1;
    height: 35%;
    border-radius: 0.2rem 0.2rem 0 0;
    background: linear-gradient(0deg, #65429d, #a476ff);
    opacity: 0.75;
  }

  .preview-chart i:nth-child(2),
  .preview-chart i:nth-child(5) {
    height: 65%;
  }

  .preview-chart i:nth-child(3),
  .preview-chart i:nth-child(6) {
    height: 85%;
  }

  .project-preview--mobile .preview-window {
    width: 66%;
    transform: perspective(900px) rotateY(-11deg) rotateX(4deg) translateX(-8%);
  }

  .preview-phone {
    position: absolute;
    right: 12%;
    bottom: 8%;
    display: flex;
    width: 4.1rem;
    height: 8.3rem;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.7rem 0.45rem;
    border: 2px solid #77717f;
    border-radius: 0.85rem;
    background: #131217;
    box-shadow: 0 15px 35px rgb(0 0 0 / 40%);
    transform: rotate(7deg);
  }

  .preview-phone div {
    width: 45%;
    height: 0.18rem;
    align-self: center;
    border-radius: 1rem;
    background: #6b6672;
  }

  .preview-phone b,
  .preview-phone i,
  .preview-phone span {
    display: block;
    height: 1rem;
    border-radius: 0.25rem;
    background: #282430;
  }

  .preview-phone b {
    height: 2rem;
    background: linear-gradient(135deg, #a476ff80, #553483);
  }

  .preview-phone i:nth-of-type(2) {
    width: 75%;
  }

  .preview-phone span {
    height: 0.65rem;
    margin-top: auto;
    background: var(--sec);
  }

  .project-preview--workflow .preview-chart {
    height: 2.4rem;
    align-items: center;
    border: 0;
  }

  .project-preview--workflow .preview-chart i {
    position: relative;
    height: 0.6rem;
    border: 1px solid #a476ff80;
    border-radius: 0.35rem;
    background: #28212f;
  }

  .project-preview--workflow .preview-chart i:nth-child(n) {
    height: 0.6rem;
  }

  .project-preview--product .preview-screen {
    min-height: 10.5rem;
    grid-template-columns: 1fr;
    background:
      radial-gradient(
        ellipse at 72% 45%,
        rgb(164 118 255 / 30%),
        transparent 44%
      ),
      #101013;
  }

  .project-preview--product .preview-sidebar {
    display: none;
  }

  .project-preview--product .preview-main {
    align-self: center;
    padding: 1.2rem;
  }

  .project-preview--product .preview-panels {
    grid-template-columns: 1fr 1fr;
  }

  .preview-index {
    position: absolute;
    top: 1rem;
    left: 1.2rem;
    color: rgb(255 255 255 / 50%);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
  }

  .project-card__details {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 1rem;
    width: 100%;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .project-card__heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .project-number {
    color: var(--sec);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  .project-type {
    color: var(--white-icon);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card__details h3 {
    max-width: 18ch;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .project-pending {
    padding: 0.45rem 0.65rem;
    border: 1px solid #a476ff55;
    border-radius: 999px;
    color: var(--sec);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    transition:
      border-color 350ms ease,
      background-color 350ms ease;
  }

  .project-card.is-active .project-pending {
    border-color: #a476ff99;
    background: rgb(164 118 255 / 10%);
  }

  @media (max-width: 767px) {
    .projects-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.85rem;
    }

    .projects-showcase {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .projects-visual {
      top: 5.5rem;
      height: 15rem;
      min-height: 0;
      border-radius: 1.1rem;
    }

    .project-card {
      min-height: 15rem;
      border-radius: 1.1rem;
    }

    .project-pending {
      font-size: 0.52rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-preview {
      transform: none;
    }
  }
</style>
