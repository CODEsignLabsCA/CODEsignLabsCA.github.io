---
import { db } from "../firebase";
import { collection, getDocs } from "firebase/firestore";

type FirestoreProject = {
  title: string;
  description: string;
  link?: string;
  image: string;
  screensDesktop?: string[];
  screensMobile?: string[];
};

const toScreenArray = (screens: unknown, legacyScreen?: unknown): string[] => {
  if (Array.isArray(screens)) {
    return screens.filter(
      (screen): screen is string =>
        typeof screen === "string" && screen.length > 0,
    );
  }

  return typeof legacyScreen === "string" && legacyScreen ? [legacyScreen] : [];
};

const isSpanish = Astro.currentLocale === "es";
const querySnapshot = await getDocs(collection(db, "projects"));
const projectsSlots = querySnapshot.docs.map((projectDoc) => {
  const data = projectDoc.data();
  const project = data as FirestoreProject;

  return {
    ...project,
    id: projectDoc.id,
    screensDesktop: toScreenArray(
      data.screensDesktop,
      data.screenAppDesktop ?? data.screenApp,
    ),
    screensMobile: toScreenArray(data.screensMobile, data.screenAppMobile),
    layout: "product" as const,
  };
});
---

<section
  id="projects"
  class="scroll-mt-28 border-t border-[#ffffff10] py-16 text-[var(--white)] md:py-20"
>
  <div class="mx-auto max-w-6xl">
    <div class="projects-heading">
      <div>
        <p class="mb-2 text-lg text-[var(--sec)] shiny-sec">
          {isSpanish ? "Proyectos seleccionados" : "Selected work"}
        </p>
        <h2 class="text-4xl font-medium md:text-5xl">
          {isSpanish ? "Proyectos" : "Projects"}
        </h2>
      </div>
      <p class="projects-note">
        {isSpanish
          ? "Sistemas de software comercial diseñados para operaciones reales y un crecimiento escalable."
          : "Commercial software systems engineered for real-world operations and scalable growth."}
      </p>
    </div>

    <div class="projects-showcase" data-project-showcase>
      <div class="projects-visual">
        {projectsSlots.map((project, index) => (
          <div
            class:list={[
              "project-preview",
              `project-preview--${project.layout}`,
              { "is-active": index === 0 },
            ]}
            data-project-preview={index}
          >
            <div class="preview-window">
              <div class="preview-toolbar">
                <span></span>
                <span></span>
                <span></span>
                <i></i>
              </div>
              {project.screensDesktop.length > 0 && (
                <div
                  class="screenshot-carousel screenshot-carousel--desktop"
                  aria-label={
                    isSpanish
                      ? `Capturas de escritorio de ${project.title}`
                      : `${project.title} desktop screenshots`
                  }
                  data-screenshot-carousel
                >
                  {project.screensDesktop.map((screen, screenIndex) => (
                    <button
                      type="button"
                      class="preview-image-trigger preview-image-trigger--desktop"
                      data-screenshot-slide
                      data-lightbox-src={screen}
                      data-lightbox-alt={`${project.title} Desktop Interface`}
                      aria-label={
                        isSpanish
                          ? `Ampliar captura de escritorio ${screenIndex + 1} de ${project.title}`
                          : `Enlarge desktop screenshot ${screenIndex + 1} for ${project.title}`
                      }
                      hidden={screenIndex !== 0}
                    >
                      <img
                        src={screen}
                        alt=""
                        class="preview-screen-image"
                        loading="lazy"
                      />
                    </button>
                  ))}
                  {project.screensDesktop.length > 1 && (
                    <div class="screenshot-carousel__controls">
                      <button
                        type="button"
                        data-carousel-prev
                        aria-label={
                          isSpanish
                            ? "Captura de escritorio anterior"
                            : "Previous desktop screenshot"
                        }
                      >
                        &larr;
                      </button>
                      <span data-carousel-count aria-live="polite">
                        1 / {project.screensDesktop.length}
                      </span>
                      <button
                        type="button"
                        data-carousel-next
                        aria-label={
                          isSpanish
                            ? "Captura de escritorio siguiente"
                            : "Next desktop screenshot"
                        }
                      >
                        &rarr;
                      </button>
                    </div>
                  )}
                </div>
              )}
              {project.screensMobile.length > 0 && (
                <div
                  class="screenshot-carousel screenshot-carousel--mobile"
                  aria-label={
                    isSpanish
                      ? `Capturas móviles de ${project.title}`
                      : `${project.title} mobile screenshots`
                  }
                  data-screenshot-carousel
                >
                  {project.screensMobile.map((screen, screenIndex) => (
                    <button
                      type="button"
                      class="preview-image-trigger preview-image-trigger--mobile"
                      data-screenshot-slide
                      data-lightbox-src={screen}
                      data-lightbox-alt={`${project.title} Mobile Interface`}
                      aria-label={
                        isSpanish
                          ? `Ampliar captura móvil ${screenIndex + 1} de ${project.title}`
                          : `Enlarge mobile screenshot ${screenIndex + 1} for ${project.title}`
                      }
                      hidden={screenIndex !== 0}
                    >
                      <img
                        src={screen}
                        alt=""
                        class="preview-screen-image"
                        loading="lazy"
                      />
                    </button>
                  ))}
                  {project.screensMobile.length > 1 && (
                    <div class="screenshot-carousel__controls">
                      <button
                        type="button"
                        data-carousel-prev
                        aria-label={
                          isSpanish
                            ? "Captura móvil anterior"
                            : "Previous mobile screenshot"
                        }
                      >
                        &larr;
                      </button>
                      <span data-carousel-count aria-live="polite">
                        1 / {project.screensMobile.length}
                      </span>
                      <button
                        type="button"
                        data-carousel-next
                        aria-label={
                          isSpanish
                            ? "Captura móvil siguiente"
                            : "Next mobile screenshot"
                        }
                      >
                        &rarr;
                      </button>
                    </div>
                  )}
                </div>
              )}
            </div>
            <span class="preview-index">
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>
        ))}
      </div>

      <div class="projects-grid">
        {projectsSlots.map((project, index) => (
          <article
            class:list={[
              "project-card",
              "reveal",
              { "is-active": index === 0 },
            ]}
            data-project-card={index}
          >
            <div class="project-card__asset overflow-hidden border border-zinc-800 bg-zinc-900 p-0">
              <img
                class="h-full w-full object-cover"
                src={project.image}
                alt={project.title}
                loading="lazy"
              />
            </div>
            <div class="project-card__details">
              <div class="project-card__heading">
                <span class="project-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <h3>{project.title}</h3>
              <p class="project-card__description">{project.description}</p>
              {project.link && (
                <a
                  class="text-sm text-[var(--sec)] underline underline-offset-4"
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {isSpanish ? "Ver proyecto" : "View project"}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <dialog
    class="project-lightbox"
    data-project-lightbox
    aria-label={
      isSpanish
        ? "Captura ampliada del proyecto"
        : "Enlarged project screenshot"
    }
  >
    <button
      class="project-lightbox__close"
      type="button"
      data-lightbox-close
      aria-label={isSpanish ? "Cerrar imagen ampliada" : "Close enlarged image"}
    >
      &times;
    </button>
    <img data-lightbox-image alt="" />
  </dialog>
</section>

<script>
  const showcases = document.querySelectorAll<HTMLElement>(
    "[data-project-showcase]",
  );

  showcases.forEach((showcase) => {
    const lightbox = showcase
      .closest("section")
      ?.querySelector<HTMLDialogElement>("[data-project-lightbox]");
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>(
      "[data-lightbox-image]",
    );

    showcase
      .querySelectorAll<HTMLButtonElement>("[data-lightbox-src]")
      .forEach((trigger) => {
        trigger.addEventListener("click", () => {
          if (!lightbox || !lightboxImage) return;
          lightboxImage.src = trigger.dataset.lightboxSrc ?? "";
          lightboxImage.alt = trigger.dataset.lightboxAlt ?? "";
          lightbox.showModal();
        });
      });

    lightbox
      ?.querySelector("[data-lightbox-close]")
      ?.addEventListener("click", () => lightbox.close());
    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) lightbox.close();
    });

    showcase
      .querySelectorAll<HTMLElement>("[data-screenshot-carousel]")
      .forEach((carousel) => {
        const slides = Array.from(
          carousel.querySelectorAll<HTMLButtonElement>(
            "[data-screenshot-slide]",
          ),
        );
        const counter = carousel.querySelector<HTMLElement>(
          "[data-carousel-count]",
        );

        if (slides.length < 2) return;

        let activeIndex = 0;
        const showSlide = (nextIndex: number) => {
          activeIndex = (nextIndex + slides.length) % slides.length;
          slides.forEach((slide, slideIndex) => {
            slide.hidden = slideIndex !== activeIndex;
          });
          if (counter) {
            counter.textContent = `${activeIndex + 1} / ${slides.length}`;
          }
        };

        carousel
          .querySelector("[data-carousel-prev]")
          ?.addEventListener("click", () => showSlide(activeIndex - 1));
        carousel
          .querySelector("[data-carousel-next]")
          ?.addEventListener("click", () => showSlide(activeIndex + 1));
      });

    const cards = Array.from(
      showcase.querySelectorAll<HTMLElement>("[data-project-card]"),
    );
    const previews = Array.from(
      showcase.querySelectorAll<HTMLElement>("[data-project-preview]"),
    );

    if (!cards.length || cards.length !== previews.length) return;

    const activateProject = (index: number) => {
      cards.forEach((card, cardIndex) => {
        card.classList.toggle("is-active", cardIndex === index);
      });
      previews.forEach((preview, previewIndex) => {
        preview.classList.toggle("is-active", previewIndex === index);
      });
    };

    activateProject(0);

    const observer = new IntersectionObserver(
      (entries) => {
        const activeEntries = entries.filter((entry) => entry.isIntersecting);
        if (!activeEntries.length) return;

        const closestEntry = activeEntries.reduce((closest, entry) => {
          const entryCenter =
            entry.boundingClientRect.top + entry.boundingClientRect.height / 2;
          const closestCenter =
            closest.boundingClientRect.top +
            closest.boundingClientRect.height / 2;

          return Math.abs(entryCenter - window.innerHeight / 2) <
            Math.abs(closestCenter - window.innerHeight / 2)
            ? entry
            : closest;
        });

        const activeIndex = Number(
          closestEntry.target.getAttribute("data-project-card"),
        );
        if (Number.isInteger(activeIndex)) activateProject(activeIndex);
      },
      { rootMargin: "-38% 0px -38% 0px", threshold: 0 },
    );

    cards.forEach((card) => observer.observe(card));
  });
</script>

<style>
  .preview-image-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .screenshot-carousel [hidden] {
    display: none;
  }

  .screenshot-carousel {
    position: relative;
  }

  .screenshot-carousel--desktop {
    width: 100%;
  }

  .preview-image-trigger--desktop {
    overflow: hidden;
    border-radius: 0 0 0.75rem 0.75rem;
  }

  .screenshot-carousel--mobile {
    position: absolute;
    z-index: 2;
    right: -8%;
    bottom: -10%;
    width: clamp(3.5rem, 18%, 5.5rem);
    height: 72%;
  }

  .preview-image-trigger--mobile {
    position: absolute;
    inset: 0;
    height: 100%;
    padding: 0.28rem;
    overflow: hidden;
    border: 2px solid #77717f;
    border-radius: 0.9rem;
    background: #131217;
    box-shadow: 0 15px 35px rgb(0 0 0 / 45%);
  }

  .screenshot-carousel__controls {
    position: absolute;
    z-index: 3;
    right: 0.4rem;
    bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.3rem;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 9999px;
    background: rgb(16 16 19 / 88%);
    color: white;
    font-size: 0.65rem;
    line-height: 1;
    backdrop-filter: blur(6px);
  }

  .screenshot-carousel__controls button {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border: 0;
    border-radius: 9999px;
    background: rgb(255 255 255 / 12%);
    color: inherit;
    cursor: pointer;
  }

  .screenshot-carousel--mobile .screenshot-carousel__controls {
    right: 0.25rem;
    bottom: 0.35rem;
    left: 0.25rem;
    justify-content: space-between;
    gap: 0.1rem;
    padding: 0.15rem;
    font-size: 0.55rem;
  }

  .screenshot-carousel--mobile .screenshot-carousel__controls button {
    width: 1.1rem;
    height: 1.1rem;
  }

  .preview-screen-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
  }

  .preview-image-trigger--mobile .preview-screen-image {
    width: 100%;
    height: 100%;
    border-radius: 0.6rem;
    object-fit: cover;
    object-position: top;
  }

  .project-lightbox {
    position: fixed;
    width: min(94vw, 90rem);
    max-width: none;
    max-height: 92dvh;
    padding: 3.5rem 1rem 1rem;
    overflow: visible;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 1rem;
    background: #111014;
    color: var(--white);
  }

  .project-lightbox::backdrop {
    background: rgb(0 0 0 / 82%);
    backdrop-filter: blur(5px);
  }

  .project-lightbox img {
    display: block;
    width: 100%;
    max-height: calc(92dvh - 5rem);
    margin: 0 auto;
    border-radius: 0.5rem;
    object-fit: contain;
  }

  .project-lightbox__close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 9999px;
    background: #24212a;
    color: white;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .projects-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .projects-note {
    max-width: 29rem;
    color: var(--white-icon);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .projects-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .projects-visual {
    position: sticky;
    top: 7rem;
    min-width: 0;
    height: min(34rem, 58vh);
    min-height: 22rem;
    overflow: hidden;
    border: 1px solid var(--white-icon-tr);
    border-radius: 1.5rem;
    background: #141318;
    box-shadow: 0 24px 70px rgb(0 0 0 / 24%);
  }

  .projects-grid {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1rem;
  }

  .project-card {
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(13rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 1.5rem;
    background: #141318;
    opacity: 0.64;
    transition:
      border-color 400ms ease,
      background-color 400ms ease,
      box-shadow 450ms ease,
      opacity 400ms ease;
  }

  .project-card.is-active {
    border-color: #a476ff80;
    background-color: #19161f;
    box-shadow: 0 18px 48px rgb(0 0 0 / 22%);
    opacity: 1;
  }

  .project-preview {
    display: grid;
    position: absolute;
    inset: 0;
    place-items: center;
    overflow: hidden;
    border: 0;
    background:
      radial-gradient(
        ellipse at 70% 20%,
        rgb(164 118 255 / 18%),
        transparent 48%
      ),
      linear-gradient(145deg, #1d1b25, #111);
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition:
      opacity 450ms ease,
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project-preview.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .project-preview.is-active .preview-window {
    transform: perspective(900px) rotateY(0) rotateX(0) scale(1.02);
  }

  .preview-window {
    position: relative;
    width: 76%;
    overflow: visible;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 0.8rem;
    background: #101013;
    box-shadow: 0 24px 60px rgb(0 0 0 / 35%);
    transform: perspective(900px) rotateY(-7deg) rotateX(3deg);
    transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .preview-toolbar {
    display: flex;
    height: 1.35rem;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
    background: #1c1b20;
  }

  .preview-toolbar > span {
    width: 0.27rem;
    height: 0.27rem;
    border-radius: 50%;
    background: #625e69;
  }

  .preview-toolbar > span:first-child {
    background: #a476ff;
  }

  .preview-toolbar > i {
    width: 30%;
    height: 0.25rem;
    margin-left: 0.5rem;
    border-radius: 1rem;
    background: rgb(255 255 255 / 8%);
  }

  .preview-screen {
    display: grid;
    min-height: 10rem;
    grid-template-columns: 19% 1fr;
  }

  .preview-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem 0.5rem;
    border-right: 1px solid rgb(255 255 255 / 7%);
  }

  .preview-sidebar b,
  .preview-sidebar i,
  .preview-heading i,
  .preview-heading b,
  .preview-panel i,
  .preview-panel b,
  .preview-panel span {
    display: block;
    border-radius: 1rem;
    background: rgb(255 255 255 / 11%);
  }

  .preview-sidebar b {
    width: 70%;
    height: 0.45rem;
    margin-bottom: 0.25rem;
    background: var(--sec);
  }

  .preview-sidebar i {
    width: 85%;
    height: 0.28rem;
  }

  .preview-main {
    padding: 0.85rem;
  }

  .preview-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .preview-heading i {
    width: 35%;
    height: 0.42rem;
    background: rgb(255 255 255 / 55%);
  }

  .preview-heading b {
    width: 18%;
    height: 0.4rem;
    background: rgb(164 118 255 / 75%);
  }

  .preview-panels {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 0.45rem;
  }

  .preview-panel {
    min-height: 2.4rem;
    padding: 0.45rem;
    border: 1px solid rgb(255 255 255 / 7%);
    border-radius: 0.35rem;
    background: #19181e;
  }

  .preview-panel i {
    width: 55%;
    height: 0.25rem;
    margin-bottom: 0.4rem;
    background: rgb(164 118 255 / 65%);
  }

  .preview-panel b {
    width: 75%;
    height: 0.45rem;
    background: rgb(255 255 255 / 22%);
  }

  .preview-panel span {
    width: 45%;
    height: 0.25rem;
    margin-top: 0.35rem;
  }

  .preview-chart {
    display: flex;
    height: 2.8rem;
    align-items: end;
    gap: 0.4rem;
    margin-top: 0.55rem;
    padding: 0 0.35rem;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
  }

  .preview-chart i {
    flex: 1;
    height: 35%;
    border-radius: 0.2rem 0.2rem 0 0;
    background: linear-gradient(0deg, #65429d, #a476ff);
    opacity: 0.75;
  }

  .preview-chart i:nth-child(2),
  .preview-chart i:nth-child(5) {
    height: 65%;
  }

  .preview-chart i:nth-child(3),
  .preview-chart i:nth-child(6) {
    height: 85%;
  }

  .project-preview--mobile .preview-window {
    width: 66%;
    transform: perspective(900px) rotateY(-11deg) rotateX(4deg) translateX(-8%);
  }

  .preview-phone {
    position: absolute;
    right: 12%;
    bottom: 8%;
    display: flex;
    width: 4.1rem;
    height: 8.3rem;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.7rem 0.45rem;
    border: 2px solid #77717f;
    border-radius: 0.85rem;
    background: #131217;
    box-shadow: 0 15px 35px rgb(0 0 0 / 40%);
    transform: rotate(7deg);
  }

  .preview-phone div {
    width: 45%;
    height: 0.18rem;
    align-self: center;
    border-radius: 1rem;
    background: #6b6672;
  }

  .preview-phone b,
  .preview-phone i,
  .preview-phone span {
    display: block;
    height: 1rem;
    border-radius: 0.25rem;
    background: #282430;
  }

  .preview-phone b {
    height: 2rem;
    background: linear-gradient(135deg, #a476ff80, #553483);
  }

  .preview-phone i:nth-of-type(2) {
    width: 75%;
  }

  .preview-phone span {
    height: 0.65rem;
    margin-top: auto;
    background: var(--sec);
  }

  .project-preview--workflow .preview-chart {
    height: 2.4rem;
    align-items: center;
    border: 0;
  }

  .project-preview--workflow .preview-chart i {
    position: relative;
    height: 0.6rem;
    border: 1px solid #a476ff80;
    border-radius: 0.35rem;
    background: #28212f;
  }

  .project-preview--workflow .preview-chart i:nth-child(n) {
    height: 0.6rem;
  }

  .project-preview--product .preview-screen {
    min-height: 10.5rem;
    grid-template-columns: 1fr;
    background:
      radial-gradient(
        ellipse at 72% 45%,
        rgb(164 118 255 / 30%),
        transparent 44%
      ),
      #101013;
  }

  .project-preview--product .preview-sidebar {
    display: none;
  }

  .project-preview--product .preview-main {
    align-self: center;
    padding: 1.2rem;
  }

  .project-preview--product .preview-panels {
    grid-template-columns: 1fr 1fr;
  }

  .preview-index {
    position: absolute;
    top: 1rem;
    left: 1.2rem;
    color: rgb(255 255 255 / 50%);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
  }

  .project-card__details {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 0.85rem;
    width: 100%;
