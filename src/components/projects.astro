---
const isSpanish = Astro.currentLocale === "es";
---

<section
  id="projects"
  class="scroll-mt-28 border-t border-[#ffffff10] py-16 text-[var(--white)] md:py-20"
>
  <div class="mx-auto max-w-6xl">
    <div class="projects-heading">
      <div>
        <p class="mb-2 text-lg text-[var(--sec)] shiny-sec">
          {isSpanish ? "Proyectos seleccionados" : "Selected work"}
        </p>
        <h2 class="text-4xl font-medium md:text-5xl">
          {isSpanish ? "Proyectos" : "Projects"}
        </h2>
      </div>
      <p class="projects-note">
        {isSpanish
          ? "Sistemas de software comercial diseñados para operaciones reales y un crecimiento escalable."
          : "Commercial software systems engineered for real-world operations and scalable growth."}
      </p>
    </div>

    <div id="realtime-projects-showcase"></div>
  </div>

  <dialog
    class="project-lightbox"
    data-project-lightbox
    aria-label={
      isSpanish
        ? "Captura ampliada del proyecto"
        : "Enlarged project screenshot"
    }
  >
    <button
      class="project-lightbox__close"
      type="button"
      data-lightbox-close
      aria-label={isSpanish ? "Cerrar imagen ampliada" : "Close enlarged image"}
    >
      &times;
    </button>
    <img data-lightbox-image alt="" />
  </dialog>
</section>

<script>
  import { db } from "../firebase";
  import { collection, onSnapshot } from "firebase/firestore";

  type Project = {
    id: string;
    title: string;
    description: string;
    descriptionEN: string;
    businessImpact: string;
    businessImpactEN: string;
    coreArchitecture: string;
    coreArchitectureEN: string;
    technicalWin: string;
    technicalWinEN: string;
    link: string;
    image: string;
    screensDesktop: string[];
    screensMobile: string[];
  };

  const container = document.getElementById("realtime-projects-showcase");
  const isSpanish =
    window.location.pathname.startsWith("/es") ||
    window.location.pathname.includes("/es/");
  const lightbox = document.querySelector<HTMLDialogElement>(
    "[data-project-lightbox]",
  );
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>(
    "[data-lightbox-image]",
  );
  let projectObserver: IntersectionObserver | undefined;

  const escapeHtml = (value: string): string =>
    value.replace(/[&<>"']/g, (character) => {
      const entities: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return entities[character];
    });

  const safeAssetUrl = (value: unknown): string => {
    if (typeof value !== "string" || !value.trim()) return "";
    const url = value.trim();
    if (url.startsWith("/") && !url.startsWith("//")) return url;

    try {
      const parsed = new URL(url, window.location.origin);
      return parsed.protocol === "https:" ? parsed.href : "";
    } catch {
      return "";
    }
  };

  const safeLinkUrl = (value: unknown): string => {
    if (typeof value !== "string" || !value.trim()) return "";
    const url = value.trim();
    if (url.startsWith("/") && !url.startsWith("//")) return url;

    try {
      const parsed = new URL(url);
      return ["https:", "http:"].includes(parsed.protocol) ? parsed.href : "";
    } catch {
      return "";
    }
  };

  const toScreenArray = (value: unknown): string[] => {
    if (Array.isArray(value)) {
      return value.flatMap((screen) => toScreenArray(screen));
    }
    if (typeof value !== "string" || !value.trim()) return [];

    const screen = value.trim();
    if (screen.startsWith("[")) {
      try {
        const parsed: unknown = JSON.parse(screen);
        return Array.isArray(parsed) ? toScreenArray(parsed) : [];
      } catch (error) {
        console.error("Invalid project screenshot array in Firestore.", error);
        return [];
      }
    }

    const safeUrl = safeAssetUrl(screen);
    return safeUrl ? [safeUrl] : [];
  };

  const toProject = (id: string, data: Record<string, unknown>): Project => ({
    id,
    title: typeof data.title === "string" ? data.title : "",
    description: typeof data.description === "string" ? data.description : "",
    descriptionEN:
      typeof data.descriptionEN === "string" ? data.descriptionEN : "",
    businessImpact:
      typeof data.businessImpact === "string" ? data.businessImpact : "",
    businessImpactEN:
      typeof data.businessImpactEN === "string" ? data.businessImpactEN : "",
    coreArchitecture:
      typeof data.coreArchitecture === "string" ? data.coreArchitecture : "",
    coreArchitectureEN:
      typeof data.coreArchitectureEN === "string"
        ? data.coreArchitectureEN
        : "",
    technicalWin:
      typeof data.technicalWin === "string" ? data.technicalWin : "",
    technicalWinEN:
      typeof data.technicalWinEN === "string" ? data.technicalWinEN : "",
    link: safeLinkUrl(data.link),
    image: safeAssetUrl(data.image),
    screensDesktop: toScreenArray(
      data.screensDesktop ?? data.screenAppDesktop ?? data.screenApp,
    ),
    screensMobile: toScreenArray(data.screensMobile ?? data.screenAppMobile),
  });

  const renderCarousel = (
    screens: string[],
    projectTitle: string,
    type: "desktop" | "mobile",
  ): string => {
    if (!screens.length) return "";

    const title = escapeHtml(projectTitle);
    const isMobile = type === "mobile";
    const label = isMobile
      ? isSpanish
        ? `Capturas móviles de ${title}`
        : `${title} mobile screenshots`
      : isSpanish
        ? `Capturas de escritorio de ${title}`
        : `${title} desktop screenshots`;
    const screenLabel = isMobile
      ? isSpanish
        ? "captura móvil"
        : "mobile screenshot"
      : isSpanish
        ? "captura de escritorio"
        : "desktop screenshot";
    const kind = isMobile ? "mobile" : "desktop";

    return `
      <div class="screenshot-carousel screenshot-carousel--${kind}" aria-label="${label}" data-screenshot-carousel>
        ${screens
          .map(
            (screen, index) => `
              <button
                type="button"
                class="preview-image-trigger preview-image-trigger--${kind}"
                data-screenshot-slide
                data-lightbox-src="${escapeHtml(screen)}"
                data-lightbox-alt="${title} ${isMobile ? "Mobile" : "Desktop"} Interface"
                aria-label="${escapeHtml(
                  isSpanish
                    ? `Ampliar ${screenLabel} ${index + 1} de ${projectTitle}`
                    : `Enlarge ${screenLabel} ${index + 1} for ${projectTitle}`,
                )}"
                ${index > 0 ? "hidden" : ""}
              >
                <img src="${escapeHtml(screen)}" alt="" class="preview-screen-image" loading="lazy" />
              </button>`,
          )
          .join("")}
        ${
          screens.length > 1
            ? `
              <div class="screenshot-carousel__controls">
                <button type="button" data-carousel-prev aria-label="${escapeHtml(
                  isSpanish
                    ? `Anterior: ${screenLabel}`
                    : `Previous ${screenLabel}`,
                )}">&larr;</button>
                <span data-carousel-count aria-live="polite">1 / ${screens.length}</span>
                <button type="button" data-carousel-next aria-label="${escapeHtml(
                  isSpanish
                    ? `Siguiente: ${screenLabel}`
                    : `Next ${screenLabel}`,
                )}">&rarr;</button>
              </div>`
            : ""
        }
      </div>`;
  };

  const initializeInteractions = () => {
    if (!container) return;

    projectObserver?.disconnect();
    const carousels = container.querySelectorAll<HTMLElement>(
      "[data-screenshot-carousel]",
    );
    carousels.forEach((carousel) => {
      const slides = Array.from(
        carousel.querySelectorAll<HTMLButtonElement>("[data-screenshot-slide]"),
      );
      const counter = carousel.querySelector<HTMLElement>(
        "[data-carousel-count]",
      );
      if (slides.length < 2) return;

      let activeIndex = 0;
      const showSlide = (nextIndex: number) => {
        activeIndex = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => {
          slide.hidden = slideIndex !== activeIndex;
        });
        if (counter)
          counter.textContent = `${activeIndex + 1} / ${slides.length}`;
      };

      carousel
        .querySelector("[data-carousel-prev]")
        ?.addEventListener("click", () => showSlide(activeIndex - 1));
      carousel
        .querySelector("[data-carousel-next]")
        ?.addEventListener("click", () => showSlide(activeIndex + 1));
    });

    const cards = Array.from(
      container.querySelectorAll<HTMLElement>("[data-project-card]"),
    );
    const previews = Array.from(
      container.querySelectorAll<HTMLElement>("[data-project-preview]"),
    );
    if (!cards.length || cards.length !== previews.length) return;

    const activateProject = (index: number) => {
      cards.forEach((card, cardIndex) => {
        card.classList.toggle("is-active", cardIndex === index);
      });
      previews.forEach((preview, previewIndex) => {
        preview.classList.toggle("is-active", previewIndex === index);
      });
    };

    activateProject(0);
    projectObserver = new IntersectionObserver(
      (entries) => {
        const activeEntries = entries.filter((entry) => entry.isIntersecting);
        if (!activeEntries.length) return;

        const closestEntry = activeEntries.reduce((closest, entry) => {
          const entryCenter =
            entry.boundingClientRect.top + entry.boundingClientRect.height / 2;
          const closestCenter =
            closest.boundingClientRect.top +
            closest.boundingClientRect.height / 2;

          return Math.abs(entryCenter - window.innerHeight / 2) <
            Math.abs(closestCenter - window.innerHeight / 2)
            ? entry
            : closest;
        });
        const activeIndex = Number(
          closestEntry.target.getAttribute("data-project-card"),
        );
        if (Number.isInteger(activeIndex)) activateProject(activeIndex);
      },
      { rootMargin: "-38% 0px -38% 0px", threshold: 0 },
    );
    cards.forEach((card) => projectObserver?.observe(card));
  };

  if (!container) {
    console.error("Missing #realtime-projects-showcase container.");
  } else {
    container.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLButtonElement>("[data-lightbox-src]");
      if (!trigger || !lightbox || !lightboxImage) return;

      lightboxImage.src = trigger.dataset.lightboxSrc ?? "";
      lightboxImage.alt = trigger.dataset.lightboxAlt ?? "";
      lightbox.showModal();
    });

    lightbox
      ?.querySelector("[data-lightbox-close]")
      ?.addEventListener("click", () => lightbox.close());
    lightbox?.addEventListener("click", (event) => {
      if (event.target === lightbox) lightbox.close();
    });

    const stopListening = onSnapshot(
      collection(db, "projects"),
      (snapshot) => {
        const projects = snapshot.docs.flatMap((projectDoc) => {
          const projectData = projectDoc.data();
          const isEnabled = projectData.enabled === true;
          if (!isEnabled) return [];

          return [toProject(projectDoc.id, projectData)];
        });

        container.innerHTML = "";
        const visual = projects
          .map((project, index) => {
            return `
              <div class="project-preview project-preview--product ${index === 0 ? "is-active" : ""}" data-project-preview="${index}">
                <div class="preview-window">
                  <div class="preview-toolbar"><span></span><span></span><span></span><i></i></div>
                  ${renderCarousel(project.screensDesktop, project.title, "desktop")}
                </div>
                ${renderCarousel(project.screensMobile, project.title, "mobile")}
                <span class="project-card__index project-preview__index" aria-hidden="true">${String(index + 1).padStart(2, "0")}</span>
              </div>`;
          })
          .join("");
        const cards = projects
          .map((project, index) => {
            const title = escapeHtml(project.title);
            const displayDescription = isSpanish
              ? project.description || ""
              : project.descriptionEN || project.description || "";
            const description = escapeHtml(displayDescription);
            const caseStudyItems = [
              {
                label: isSpanish
                  ? "🚀 Impacto de negocio"
                  : "🚀 Business Impact",
                text: isSpanish
                  ? project.businessImpact || project.businessImpactEN
                  : project.businessImpactEN || project.businessImpact,
              },
              {
                label: isSpanish
                  ? "🛠️ Arquitectura principal"
                  : "🛠️ Core Architecture",
                text: isSpanish
                  ? project.coreArchitecture || project.coreArchitectureEN
                  : project.coreArchitectureEN || project.coreArchitecture,
              },
              {
                label: isSpanish ? "📊 Logro técnico" : "📊 Technical Win",
                text: isSpanish
                  ? project.technicalWin || project.technicalWinEN
                  : project.technicalWinEN || project.technicalWin,
              },
            ].filter((item) => item.text.trim());
            const caseStudy = caseStudyItems.length
              ? `<ul class="project-card__case-study font-body">${caseStudyItems
                  .map(
                    (item) => `<li>
                      <span class="project-card__case-label">${escapeHtml(item.label)}</span>
                      <span class="project-card__case-text">${escapeHtml(item.text)}</span>
                    </li>`,
                  )
                  .join("")}</ul>`
              : `<p class="project-card__description font-body">${description}</p>`;
            const image = project.image
              ? `<img class="h-auto w-full object-contain object-center" src="${escapeHtml(project.image)}" alt="${title}" loading="lazy" />`
              : "";
            const link = project.link
              ? `<a class="text-sm text-[var(--sec)] underline underline-offset-4" href="${escapeHtml(project.link)}" target="_blank" rel="noopener noreferrer">${isSpanish ? "Ver proyecto" : "View project"}</a>`
              : "";

            return `
              <article class="project-card font-body reveal is-visible ${index === 0 ? "is-active" : ""}" data-project-card="${index}">
                <span class="project-card__index" aria-hidden="true">${String(index + 1).padStart(2, "0")}</span>
                <div class="project-card__asset w-full min-w-[150px] overflow-hidden border border-zinc-800 bg-zinc-900 p-0 md:min-w-[200px]">${image}</div>
                <div class="project-card__details">
                  <h3>${title}</h3>
                  ${caseStudy}
                  ${link}
                </div>
              </article>`;
          })
          .join("");

        container.innerHTML = projects.length
          ? `<div class="projects-showcase" data-project-showcase>
              <div class="projects-visual">${visual}</div>
              <div class="projects-grid">${cards}</div>
            </div>`
          : `<p class="projects-empty">${isSpanish ? "No hay proyectos disponibles." : "No projects are available."}</p>`;

        initializeInteractions();
      },
      (error) => {
        console.error("Failed to listen for Firestore project updates.", error);
        projectObserver?.disconnect();
        container.innerHTML = `<p class="projects-error">${isSpanish ? "No se pudieron cargar los proyectos." : "Projects could not be loaded."}</p>`;
      },
    );
    document.addEventListener("astro:before-swap", stopListening, {
      once: true,
    });
  }
</script>

<style is:global>
  .preview-image-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .screenshot-carousel [hidden] {
    display: none;
  }

  .screenshot-carousel {
    position: relative;
  }

  .screenshot-carousel--desktop {
    width: 100%;
  }

  .preview-image-trigger--desktop {
    overflow: hidden;
    border-radius: 0 0 0.75rem 0.75rem;
  }

  .screenshot-carousel--mobile {
    position: absolute;
    z-index: 2;
    top: 2rem;
    right: 4%;
    width: clamp(4.5rem, 14%, 5.5rem);
    aspect-ratio: 410 / 1077;
  }

  .preview-image-trigger--mobile {
    position: absolute;
    inset: 0;
    height: 100%;
    padding: 0.28rem;
    overflow: hidden;
    border: 2px solid #77717f;
    border-radius: 0.9rem;
    background: #131217;
    box-shadow: 0 15px 35px rgb(0 0 0 / 45%);
  }

  .screenshot-carousel__controls {
    position: absolute;
    z-index: 3;
    right: 0.4rem;
    bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.3rem;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 9999px;
    background: rgb(16 16 19 / 88%);
    color: white;
    font-size: 0.65rem;
    line-height: 1;
    backdrop-filter: blur(6px);
  }

  .screenshot-carousel__controls button {
    display: grid;
    width: 1.35rem;
    height: 1.35rem;
    place-items: center;
    border: 0;
    border-radius: 9999px;
    background: rgb(255 255 255 / 12%);
    color: inherit;
    cursor: pointer;
  }

  .screenshot-carousel--mobile .screenshot-carousel__controls {
    right: 0.25rem;
    bottom: 0.35rem;
    left: 0.25rem;
    justify-content: space-between;
    gap: 0.1rem;
    padding: 0.15rem;
    font-size: 0.55rem;
  }

  .screenshot-carousel--mobile .screenshot-carousel__controls button {
    width: 1.1rem;
    height: 1.1rem;
  }

  .preview-screen-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
  }

  .preview-image-trigger--mobile .preview-screen-image {
    width: 100%;
    height: 100%;
    border-radius: 0.6rem;
    object-fit: cover;
    object-position: top;
  }

  .project-lightbox {
    position: fixed;
    width: min(94vw, 90rem);
    max-width: none;
    max-height: 92dvh;
    padding: 3.5rem 1rem 1rem;
    overflow: visible;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 1rem;
    background: #111014;
    color: var(--white);
  }

  .project-lightbox::backdrop {
    background: rgb(0 0 0 / 82%);
    backdrop-filter: blur(5px);
  }

  .project-lightbox img {
    display: block;
    width: 100%;
    max-height: calc(92dvh - 5rem);
    margin: 0 auto;
    border-radius: 0.5rem;
    object-fit: contain;
  }

  .project-lightbox__close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 9999px;
    background: #24212a;
    color: white;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .projects-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .projects-note {
    max-width: 29rem;
    color: var(--white-icon);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .projects-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .projects-visual {
    position: sticky;
    top: 7rem;
    min-width: 0;
    height: min(34rem, 58vh);
    min-height: 22rem;
    overflow: hidden;
    border: 1px solid var(--white-icon-tr);
    border-radius: 1.5rem;
    background: #141318;
    box-shadow: 0 24px 70px rgb(0 0 0 / 24%);
  }

  .projects-grid {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1rem;
  }

  .project-card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    display: grid;
    align-items: center;
    grid-template-columns: minmax(13rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 1.5rem;
    background: #141318;
    opacity: 0.64;
    transition:
      border-color 400ms ease,
      background-color 400ms ease,
      box-shadow 450ms ease,
      opacity 400ms ease;
  }

  .project-card__index {
    position: absolute;
    z-index: 0;
    top: -1.5rem;
    right: 0.75rem;
    color: #a476ff15;
    font-size: 7rem;
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
  }

  .project-card__asset,
  .project-card__details {
    position: relative;
    z-index: 1;
  }

  .project-preview__index {
    top: -1.5rem;
    right: auto;
    left: 0.75rem;
  }

  .project-card.is-active {
    border-color: #a476ff80;
    background-color: #19161f;
    box-shadow: 0 18px 48px rgb(0 0 0 / 22%);
    opacity: 1;
  }

  .project-preview {
    display: grid;
    position: absolute;
    inset: 0;
    place-items: center;
    overflow: hidden;
    border: 0;
    background:
      radial-gradient(
        ellipse at 70% 20%,
        rgb(164 118 255 / 18%),
        transparent 48%
      ),
      linear-gradient(145deg, #1d1b25, #111);
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition:
      opacity 450ms ease,
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project-preview.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .project-preview.is-active .preview-window {
    transform: perspective(900px) rotateY(0) rotateX(0) scale(1.02);
  }

  .preview-window {
    position: relative;
    z-index: 1;
    width: 82%;
    margin-right: auto;
    margin-left: 4%;
    overflow: visible;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 0.8rem;
    background: #101013;
    box-shadow: 0 24px 60px rgb(0 0 0 / 35%);
    transform: perspective(900px) rotateY(-7deg) rotateX(3deg);
    transition: transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .preview-toolbar {
    display: flex;
    height: 1.35rem;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
    background: #1c1b20;
  }

  .preview-toolbar > span {
    width: 0.27rem;
    height: 0.27rem;
    border-radius: 50%;
    background: #625e69;
  }

  .preview-toolbar > span:first-child {
    background: #a476ff;
  }

  .preview-toolbar > i {
    width: 30%;
    height: 0.25rem;
    margin-left: 0.5rem;
    border-radius: 1rem;
    background: rgb(255 255 255 / 8%);
  }

  .preview-screen {
    display: grid;
    min-height: 10rem;
    grid-template-columns: 19% 1fr;
  }

  .preview-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem 0.5rem;
    border-right: 1px solid rgb(255 255 255 / 7%);
  }

  .preview-sidebar b,
  .preview-sidebar i,
  .preview-heading i,
  .preview-heading b,
  .preview-panel i,
  .preview-panel b,
  .preview-panel span {
    display: block;
    border-radius: 1rem;
    background: rgb(255 255 255 / 11%);
  }

  .preview-sidebar b {
    width: 70%;
    height: 0.45rem;
    margin-bottom: 0.25rem;
    background: var(--sec);
  }

  .preview-sidebar i {
    width: 85%;
    height: 0.28rem;
  }

  .preview-main {
    padding: 0.85rem;
  }

  .preview-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .preview-heading i {
    width: 35%;
    height: 0.42rem;
    background: rgb(255 255 255 / 55%);
  }

  .preview-heading b {
    width: 18%;
    height: 0.4rem;
    background: rgb(164 118 255 / 75%);
  }

  .preview-panels {
