---
import AnimatedHeading from "./AnimatedHeading.astro";

const visionariesAccordions = [
  {
    title: "Engineering Approach",
    items: [
      {
        title: "Domain-Driven Design (DDD)",
        description:
          "A radical separation of business logic from the technical core. This enables system scaling and the introduction of complex features without compromising existing stability.",
      },
      {
        title: "Clean and SOLID Architecture",
        description:
          "Decoupled code, independent of both the database and the user interface. This ensures robust automated unit testing and seamless technology migrations.",
      },
      {
        title: "Kotlin Multiplatform (KMP)",
        description:
          "Centralization of algorithms and data flows into a single, shared logical core, delivering native-level performance across iOS, Android, and the Web.",
      },
    ],
  },
  {
    title: "Automation Philosophy",
    items: [
      {
        title: "AI-Augmented Development",
        description:
          "Programming assisted by tools like Argon (within the Antigravity ecosystem) and GitHub Copilot. We automate repetitive coding tasks to accelerate time-to-market.",
      },
      {
        title: "Automated CI/CD Pipelines",
        description:
          "Fully automated deployment. Every change to the repository is compiled, tested, and pushed to production—whether on servers or app stores (App Store/Play Store)—eliminating the risk of human error.",
      },
      {
        title: "BaaS and Serverless Infrastructure",
        description:
          "An agile architecture leveraging Supabase and Firebase. Backend setup time is reduced to minutes, allowing for the immediate activation of databases and payment gateways.",
      },
    ],
  },
];
---

<section
  id="about"
  class="about-section scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading eyebrow="About us" title="Get to know the visionaries" />

    <div class="grid md:grid-cols-[1.1fr_0.9fr] gap-10 md:gap-16 items-center">
      <div class="reveal space-y-5 text-[var(--white-icon)] text-lg leading-relaxed">
        <p>
          We are not programmers; we are product engineers. We combine the
          mathematical precision of development with automated workflows to
          create highly profitable software assets.
        </p>
        <div class="visionaries-accordions" aria-label="Engineering and automation details">
          {visionariesAccordions.map((accordion) => (
            <details
              class="visionary-accordion"
              name="visionaries-accordion"
            >
              <summary class="visionary-accordion__trigger">
                <span>{accordion.title}</span>
                <span class="visionary-accordion__icon" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="m5 7.5 5 5 5-5" />
                  </svg>
                </span>
              </summary>
              <ul class="visionary-accordion__content">
                {accordion.items.map((item) => (
                  <li>
                    <strong>{item.title}</strong>
                    <p>{item.description}</p>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </div>

      <div class="about-visual" aria-label="Our engineering team">
        <figure class="about-visual__image about-visual__image--primary">
          <img
            src="/images/service-sections/Get to Know the Visionaries_1.webp"
            alt="Product engineers collaborating around a computer, framed by a green and violet diamond"
            width="619"
            height="640"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="about-visual__image about-visual__image--secondary">
          <img
            src="/images/service-sections/Get to Know the Visionaries_2.webp"
            alt="Two colleagues working together, framed by a violet diamond"
            width="642"
            height="619"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .about-visual {
    position: relative;
    min-height: 33rem;
    isolation: isolate;
  }

  .visionaries-accordions {
    margin-top: 1.25rem;
    border-top: 1px solid var(--white-icon-tr);
    color: var(--white);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .visionary-accordion {
    border-bottom: 1px solid var(--white-icon-tr);
  }

  .visionary-accordion__trigger {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    list-style: none;
  }

  .visionary-accordion__trigger::-webkit-details-marker {
    display: none;
  }

  .visionary-accordion__icon {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgb(243 243 243 / 35%);
    border-radius: 50%;
    transition:
      border-color 250ms ease,
      transform 250ms ease;
  }

  .visionary-accordion__icon svg {
    width: 1rem;
    height: 1rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .visionary-accordion[open] .visionary-accordion__icon {
    border-color: var(--sec);
    color: var(--sec);
    transform: rotate(180deg);
  }

  .visionary-accordion__content {
    display: grid;
    gap: 1rem;
    padding: 0 2.5rem 1.25rem 1.25rem;
    color: var(--white-icon);
    font-size: 0.88rem;
    list-style: disc;
  }

  .visionary-accordion__content li {
    padding-left: 0.1rem;
  }

  .visionary-accordion__content strong {
    color: var(--white);
    font-weight: 600;
  }

  .visionary-accordion__content p {
    margin-top: 0.25rem;
  }

  .visionary-accordion__trigger:focus-visible {
    outline: 2px solid var(--sec);
    outline-offset: 4px;
  }

  .about-visual__image {
    position: absolute;
    display: block;
    width: min(78%, 23rem);
    margin: 0;
    opacity: 0;
    transition:
      opacity 650ms ease,
      transform 800ms cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: opacity, transform;
  }

  .about-visual__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .about-visual__image--primary {
    z-index: 2;
    top: 0;
    left: 0;
    transform: translate3d(-2rem, -1rem, 0) rotate(-7deg) scale(0.88);
    transition-delay: 80ms;
  }

  .about-visual__image--secondary {
    z-index: 1;
    right: -26%;
    bottom: 0;
    width: min(78%, 23rem);
    transform: translate3d(2rem, 1.5rem, 0) rotate(7deg) scale(0.88);
    transition-delay: 180ms;
  }

  .about-visual__image--primary.is-visible,
  .about-visual__image--secondary.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotate(0) scale(1);
  }

  @media (max-width: 1023px) {
    .about-visual {
      min-height: 27rem;
    }

    .about-visual__image {
      width: min(78%, 20rem);
    }
  }

  @media (max-width: 767px) {
    .about-visual {
      min-height: 24rem;
    }

    .about-visual__image {
      width: min(72%, 18rem);
    }

    .about-visual__image--secondary {
      right: -16%;
      bottom: 0;
      width: min(78%, 20rem);
    }

  }

  @media (max-width: 480px) {
    .about-visual {
      min-height: 21rem;
    }

    .about-visual__image--primary {
      left: -4%;
    }

    .about-visual__image--secondary {
      right: -10%;
      width: min(72%, 18rem);
    }

  }

  @media (min-width: 768px) {
    .about-section {
      overflow-x: clip;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-visual__image,
    .about-visual__image--primary,
    .about-visual__image--secondary {
      opacity: 1;
      transform: none;
      transition: none;
      will-change: auto;
    }
  }
</style>

<script>
  const visionaryImages = document.querySelectorAll<HTMLElement>(
    ".about-visual__image",
  );
  const visionaryImageObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle("is-visible", entry.isIntersecting);
      });
    },
    { threshold: 0.12 },
  );

  visionaryImages.forEach((image) => visionaryImageObserver.observe(image));
</script>
