---
import AnimatedHeading from "./AnimatedHeading.astro";
---

<section
  id="about"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading eyebrow="About us" title="Get to know the visionaries" />

    <div class="grid md:grid-cols-[1.1fr_0.9fr] gap-10 md:gap-16 items-center">
      <div class="reveal space-y-5 text-[var(--white-icon)] text-lg leading-relaxed">
        <p>
          We are not programmers; we are product engineers. We combine the
          mathematical precision of development with automated workflows to
          create highly profitable software assets.
        </p>
        <p>
          <strong class="text-[var(--white)]">Engineering Approach:</strong>{" "}
          Robust and modular software architectures.
        </p>
        <p>
          <strong class="text-[var(--white)]">Philosophy:</strong> Maximum
          efficiency through advanced automation.
        </p>
        <a
          href="#services"
          class="inline-flex items-center gap-2 text-[var(--sec)] font-medium transition-colors hover:text-[var(--white)]"
        >
          Learn More..
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="about-visual reveal relative min-h-64 md:min-h-80 flex items-center justify-center">
        <div class="about-visual__halo" aria-hidden="true"></div>
        <div class="about-visual__frame" aria-hidden="true"></div>
        <div class="about-visual__card relative z-10 rounded-3xl border border-[var(--white-icon-tr)] bg-[var(--component-bg)] p-7 md:p-9">
          <img
            src="/svg/iso_codesignlabs_2x.png"
            alt=""
            width="64"
            height="64"
            class="mb-6 h-16 w-16 object-contain"
            loading="lazy"
          />
          <p class="text-sm uppercase tracking-[0.2em] text-[var(--sec)]">
            Engineering approach
          </p>
          <p class="mt-3 text-2xl md:text-3xl font-medium leading-snug">
            Highly profitable software assets.
          </p>
        </div>
        <div class="about-visual__dots" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-visual__halo {
    position: absolute;
    width: 15rem;
    height: 15rem;
    border-radius: 50%;
    background: var(--sec);
    opacity: 0.15;
    filter: blur(70px);
  }

  .about-visual__frame {
    position: absolute;
    width: 13rem;
    height: 13rem;
    border: 1px solid #a476ff66;
    border-radius: 2rem;
    transform: rotate(12deg);
  }

  .about-visual__card {
    max-width: 22rem;
    backdrop-filter: blur(18px);
  }

  .about-visual__dots {
    position: absolute;
    right: 4%;
    top: 8%;
    width: 6rem;
    height: 6rem;
    background-image: radial-gradient(var(--sec) 1.5px, transparent 1.5px);
    background-size: 13px 13px;
    opacity: 0.5;
  }
</style>
