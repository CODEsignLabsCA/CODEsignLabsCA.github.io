---
import AnimatedHeading from "./AnimatedHeading.astro";
---

<section
  id="about"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading eyebrow="About us" title="Get to know the visionaries" />

    <div class="grid md:grid-cols-[1.1fr_0.9fr] gap-10 md:gap-16 items-center">
      <div class="reveal space-y-5 text-[var(--white-icon)] text-lg leading-relaxed">
        <p>
          We are not programmers; we are product engineers. We combine the
          mathematical precision of development with automated workflows to
          create highly profitable software assets.
        </p>
        <p>
          <strong class="text-[var(--white)]">Engineering Approach:</strong>{" "}
          Robust and modular software architectures.
        </p>
        <p>
          <strong class="text-[var(--white)]">Philosophy:</strong> Maximum
          efficiency through advanced automation.
        </p>
      </div>

      <div class="about-visual" aria-label="Our engineering team">
        <figure class="about-visual__image about-visual__image--primary">
          <img
            src="/images/service-sections/Get to Know the Visionaries_1.webp"
            alt="Product engineers collaborating around a computer, framed by a green and violet diamond"
            width="619"
            height="640"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="about-visual__image about-visual__image--secondary">
          <img
            src="/images/service-sections/Get to Know the Visionaries_2.webp"
            alt="Two colleagues working together, framed by a violet diamond"
            width="1237"
            height="1237"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .about-visual {
    position: relative;
    min-height: 33rem;
    isolation: isolate;
  }

  .about-visual__image {
    position: absolute;
    display: block;
    width: min(78%, 23rem);
    margin: 0;
    opacity: 0;
    transition:
      opacity 650ms ease,
      transform 800ms cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: opacity, transform;
  }

  .about-visual__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .about-visual__image--primary {
    z-index: 2;
    top: 0;
    left: 0;
    transform: translate3d(-2rem, -1rem, 0) rotate(-7deg) scale(0.88);
    transition-delay: 80ms;
  }

  .about-visual__image--secondary {
    z-index: 1;
    right: -12%;
    bottom: 0;
    width: min(78%, 23rem);
    transform: translate3d(2rem, 1.5rem, 0) rotate(7deg) scale(0.88);
    transition-delay: 180ms;
  }

  .about-visual__image--primary.is-visible,
  .about-visual__image--secondary.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) rotate(0) scale(1);
  }

  @media (max-width: 1023px) {
    .about-visual {
      min-height: 27rem;
    }

    .about-visual__image {
      width: min(78%, 20rem);
    }
  }

  @media (max-width: 767px) {
    .about-visual {
      min-height: 24rem;
    }

    .about-visual__image {
      width: min(72%, 18rem);
    }

    .about-visual__image--secondary {
      right: -10%;
      bottom: 0;
      width: min(78%, 20rem);
    }
  }

  @media (max-width: 480px) {
    .about-visual {
      min-height: 21rem;
    }

    .about-visual__image--primary {
      left: -4%;
    }

    .about-visual__image--secondary {
      right: -8%;
      width: min(72%, 18rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-visual__image,
    .about-visual__image--primary,
    .about-visual__image--secondary {
      opacity: 1;
      transform: none;
      transition: none;
      will-change: auto;
    }
  }
</style>

<script>
  const visionaryImages = document.querySelectorAll<HTMLElement>(
    ".about-visual__image",
  );
  const visionaryImageObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle("is-visible", entry.isIntersecting);
      });
    },
    { threshold: 0.12 },
  );

  visionaryImages.forEach((image) => visionaryImageObserver.observe(image));
</script>
