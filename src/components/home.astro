---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "./SkillsList.astro";
import { defaultLang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale === "es" ? "es" : defaultLang;
const t = useTranslations(lang);
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-6xl mx-auto space-y-8 pb-14 pt-16 md:pt-36">
    <div class="hero-copy text-left space-y-4">
      <p class="text-md md:text-lg text-[var(--white-icon)] shiny-white">
        {t("hero.name")}
      </p>
      <div class="hero-headline">
        <h1 class="hero-title text-[var(--white)] font-medium text-pretty whitespace-normal break-words leading-none">
          {t("hero.role")}
        </h1>
        <p class="hero-description text-md md:text-2xl text-[var(--white-icon)]">
          {t("hero.description.start")}{" "}
          <span class="text-[var(--sec)] shiny-sec">{t("hero.description.highlight1")}</span>{" "}
          {t("hero.description.middle1")}{" "}
          <span class="text-[var(--sec)] shiny-sec">{t("hero.description.highlight2")}</span>
          {t("hero.description.middle2")}{" "}
          <span class="text-[var(--sec)] shiny-sec">{t("hero.description.highlight3")}</span>
          {" "}{t("hero.description.middle3")}{" "}
          <span class="text-[var(--sec)] shiny-sec">{t("hero.description.highlight4")}</span>{" "}
          {t("hero.description.end")}
        </p>
      </div>
      <div class="social-dock mt-3 md:mt-6">
        <a
          target="_blank"
          href="https://github.com"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="social-dock__link social-dock__link--github"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"></path>
          </svg>
          <span class="social-dock__tooltip" aria-hidden="true">GitHub</span>
        </a>
        <a
          target="_blank"
          href="https://www.linkedin.com/in/codesignlabs/"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="social-dock__link social-dock__link--linkedin"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"></path>
          </svg>
          <span class="social-dock__tooltip" aria-hidden="true">LinkedIn</span>
        </a>
        <a
          href="mailto:codesign.labs@gmail.com"
          aria-label={t("common.email")}
          class="social-dock__link social-dock__link--email"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="2.1em"
            height="2.1em"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill="currentColor"
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
          <span class="social-dock__tooltip" aria-hidden="true">{t("common.email")}</span>
        </a>
      </div>
    </div>

    <LogoWall />

    <div class="home-skills flex flex-col lg:flex-row items-center gap-8">
      <SkillsList />
      <div class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16">
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-copy {
    min-width: 0;
  }

  .hero-headline {
    display: grid;
    max-width: 64rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .hero-title {
    min-width: 0;
    font-size: clamp(4.5rem, calc(4.2vw + 24px), 5.25rem);
    letter-spacing: -0.075em;
    line-height: 0.92;
  }

  .hero-description {
    max-width: 36rem;
    padding-left: 1.25rem;
    border-left: 2px solid #a476ff80;
    line-height: 1.75;
  }

  .home-skills {
    margin-top: 2.5rem;
  }

  @media (max-width: 1023px) {
    .hero-headline {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .hero-title {
      font-size: clamp(3.8rem, 16vw, 5.5rem);
    }

    .hero-description {
      max-width: 43rem;
    }
  }
</style>

<style is:global>
  .social-dock {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border: 1px solid rgb(148 163 184 / 0.16);
    border-radius: 1.25rem;
    background: rgb(15 15 18 / 0.62);
    box-shadow: 0 8px 26px rgb(0 0 0 / 0.2);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .social-dock__link {
    position: relative;
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 30%;
    color: #f8fafc;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 4px 12px rgb(0 0 0 / 0.25);
    transition:
      transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 240ms ease,
      border-color 240ms ease,
      filter 240ms ease;
  }

  .social-dock__link--github {
    background: linear-gradient(145deg, #303442, #111318 75%);
  }

  .social-dock__link--linkedin {
    background: linear-gradient(145deg, #1769aa, #08335d 75%);
  }

  .social-dock__link--email {
    background: linear-gradient(145deg, #7652a8, #35204f 75%);
  }

  .social-dock__link svg {
    width: 1.5rem;
    height: 1.5rem;
    transition: filter 240ms ease;
  }

  .social-dock__link:hover {
    z-index: 1;
    transform: translateY(-6px) scale(1.15);
    border-color: rgb(255 255 255 / 0.4);
    box-shadow:
      0 12px 26px rgb(0 0 0 / 0.38),
      0 0 20px rgb(164 118 255 / 0.22);
    filter: brightness(1.14);
  }

  .social-dock__link:focus-visible {
    outline: 2px solid #a476ff;
    outline-offset: 4px;
  }

  .social-dock__tooltip {
    position: absolute;
    top: -2.35rem;
    left: 50%;
    z-index: 2;
    padding: 0.3rem 0.6rem;
    border: 1px solid rgb(148 163 184 / 0.24);
    border-radius: 0.45rem;
    background: rgb(15 15 18 / 0.94);
    color: #f8fafc;
    font-size: 0.7rem;
    line-height: 1rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.2rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .social-dock__link:hover .social-dock__tooltip,
  .social-dock__link:focus-visible .social-dock__tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .social-dock__link,
    .social-dock__link svg,
    .social-dock__tooltip {
      transition: none;
    }

    .social-dock__link:hover {
      transform: none;
    }
  }

  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>
