---
const steps = [
  {
    title: "Requirement Analysis",
    description:
      "Technical mapping aligned to your business model. We define architecture and functional scoping before coding.",
  },
  {
    title: "Rigorous Testing",
    description:
      "Automated unit, integration, and stress testing. We secure user data and logic performance under high-demand.",
  },
  {
    title: "Deployment & CI/CD",
    description:
      "Full pipeline automation. Seamless release to cloud servers, App Store, and Play Store with zero downtime.",
  },
];
---

<section
  id="process"
  class="scroll-mt-28 border-t border-[#ffffff10] py-16 text-[var(--white)] md:py-20"
>
  <div class="process-layout">
    <div class="process-heading">
      <h2 class="process-title display-heading">
        <span>Development Process</span>
        <span>That Guarantees</span>
        <span>Excellence</span>
      </h2>
    </div>

    <div class="process-collage" aria-label="Development process imagery">
      <figure class="process-artwork process-artwork--left">
        <img
          src="/images/service-sections/Development Process That Guarantees Excellence_1.webp"
          alt="A developer working at multiple monitors inside a purple and green diamond frame"
          width="575"
          height="603"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="process-artwork process-artwork--top">
        <img
          src="/images/service-sections/Development Process That Guarantees Excellence_2.webp"
          alt="A developer planning requirements beside a laptop inside a green diamond frame"
          width="475"
          height="475"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="process-artwork process-artwork--bottom">
        <img
          src="/images/service-sections/Development Process That Guarantees Excellence_3.webp"
          alt="A developer reviewing code across multiple monitors"
          width="467"
          height="446"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <ol class="process-steps">
      {steps.map((step, index) => (
        <li class:list={["process-step", `process-step--${index + 1}`]}>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-layout {
    display: grid;
    width: min(100%, 64rem);
    margin-inline: auto;
    gap: 1.5rem;
  }

  .process-heading {
    min-width: 0;
  }

  .process-title {
    font-size: clamp(2.3rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .process-title span {
    display: block;
  }

  .process-collage {
    position: relative;
    min-height: 25rem;
    margin-inline: -1rem;
    isolation: isolate;
    z-index: 1;
  }

  .process-artwork {
    position: absolute;
    margin: 0;
  }

  .process-artwork img {
    display: block;
    width: 100%;
    height: auto;
  }

  .process-artwork.motion-ready img {
    will-change: clip-path, opacity, transform;
  }

  .process-artwork--left {
    z-index: 2;
    top: 8%;
    left: -24%;
    width: 88%;
    clip-path: inset(0 0 0 30%);
  }

  .process-artwork--top {
    z-index: 0;
    top: 0;
    right: 0;
    width: 67%;
  }

  .process-artwork--bottom {
    z-index: 3;
    right: 8%;
    bottom: 0;
    width: 68%;
  }

  .process-artwork--left.is-visible img {
    animation: process-left-enter 850ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .process-artwork--left.is-hidden img {
    animation: process-left-exit 650ms cubic-bezier(0.4, 0, 0.8, 0.3) both;
  }

  .process-artwork--top.is-visible img {
    animation: process-top-enter 900ms 100ms
      cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .process-artwork--top.is-hidden img {
    animation: process-top-exit 650ms cubic-bezier(0.4, 0, 0.8, 0.3) both;
  }

  .process-artwork--bottom.is-visible img {
    animation: process-bottom-enter 800ms 180ms
      cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .process-artwork--bottom.is-hidden img {
    animation: process-bottom-exit 600ms cubic-bezier(0.4, 0, 0.8, 0.3) both;
  }

  .process-heading.is-visible .process-title span {
    animation: process-title-enter 650ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .process-heading.is-visible .process-title span:nth-child(2) {
    animation-delay: 90ms;
  }

  .process-heading.is-visible .process-title span:nth-child(3) {
    animation-delay: 180ms;
  }

  .process-heading.is-hidden .process-title span {
    animation: process-title-exit 400ms cubic-bezier(0.4, 0, 0.8, 0.3) both;
  }

  .process-step.is-visible {
    animation: process-card-enter 650ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .process-step--2.is-visible {
    animation-delay: 100ms;
  }

  .process-step--3.is-visible {
    animation-delay: 200ms;
  }

  .process-step.is-hidden {
    animation: process-card-exit 400ms cubic-bezier(0.4, 0, 0.8, 0.3) both;
  }

  @keyframes process-title-enter {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes process-title-exit {
    from {
      opacity: 1;
      transform: translateY(0);
    }

    to {
      opacity: 0;
      transform: translateY(-0.2em);
    }
  }

  @keyframes process-card-enter {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes process-card-exit {
    from {
      opacity: 1;
      transform: translateY(0);
    }

    to {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  @keyframes process-left-enter {
    from {
      clip-path: inset(0 100% 0 0);
      opacity: 0;
      transform: translateX(-2rem);
    }

    to {
      clip-path: inset(0);
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes process-left-exit {
    from {
      clip-path: inset(0);
      opacity: 1;
      transform: translateX(0);
    }

    to {
      clip-path: inset(0 100% 0 0);
      opacity: 0;
      transform: translateX(-2rem);
    }
  }

  @keyframes process-top-enter {
    from {
      clip-path: circle(0 at 50% 50%);
      opacity: 0;
      transform: rotate(8deg) scale(0.88);
    }

    to {
      clip-path: circle(75% at 50% 50%);
      opacity: 1;
      transform: rotate(0) scale(1);
    }
  }

  @keyframes process-top-exit {
    from {
      clip-path: circle(75% at 50% 50%);
      opacity: 1;
      transform: rotate(0) scale(1);
    }

    to {
      clip-path: circle(0 at 50% 50%);
      opacity: 0;
      transform: rotate(-8deg) scale(0.88);
    }
  }

  @keyframes process-bottom-enter {
    from {
      clip-path: inset(100% 0 0);
      opacity: 0;
      transform: translateY(1.75rem);
    }

    to {
      clip-path: inset(0);
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes process-bottom-exit {
    from {
      clip-path: inset(0);
      opacity: 1;
      transform: translateY(0);
    }

    to {
      clip-path: inset(100% 0 0);
      opacity: 0;
      transform: translateY(1.75rem);
    }
  }

  .process-steps {
    position: relative;
    z-index: 10;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .process-step {
    padding: 1.25rem 1.35rem;
    border-radius: 0.85rem;
  }

  .process-step--1,
  .process-step--3 {
    background: #29373a;
  }

  .process-step h3 {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .process-step p {
    margin-top: 1.25rem;
    color: var(--white-icon);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (min-width: 768px) {
    .process-layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr;
      column-gap: 1.25rem;
      row-gap: 1rem;
      min-height: 33rem;
    }

    .process-heading {
      grid-column: 6 / 13;
      grid-row: 1;
      align-self: center;
    }

    .process-title {
      font-size: clamp(1.7rem, 3.5vw, 3rem);
    }

    .process-collage {
      grid-column: 1 / 6;
      grid-row: 1 / 3;
      min-height: 31rem;
      margin-inline: 0;
    }

    .process-artwork--left {
      top: 0;
      left: calc(-30% - 0.5rem);
      width: 88%;
      clip-path: inset(0 0 0 34%);
    }

    .process-artwork--top {
      right: 0;
      width: 78%;
    }

    .process-artwork--bottom {
      right: 12%;
      bottom: 3rem;
      width: 72%;
    }

    .process-steps {
      grid-column: 6 / 13;
      grid-row: 2;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-self: end;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .process-step {
      min-height: 15.5rem;
      padding: 1.15rem 0.8rem;
    }

    .process-step--2 {
      padding-inline: 0.8rem;
    }

    .process-step--2 h3 {
      min-height: 3.08rem;
    }
  }

  @media (max-width: 767px) {
    .process-collage {
      width: 100%;
      min-height: min(100vw, 25rem);
      margin-inline: 0;
    }

    .process-artwork--left {
      left: -28%;
      width: 88%;
      clip-path: inset(0 0 0 32%);
    }

    .process-artwork--top {
      right: 0;
      width: 62%;
    }

    .process-artwork--bottom {
      right: 4%;
      width: 62%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-artwork img {
      animation: none !important;
      clip-path: none;
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
</style>

<script>
  const processSection = document.querySelector<HTMLElement>("#process");
  const processMotionTargets = Array.from(
    processSection?.querySelectorAll<HTMLElement>(
      ".process-heading, .process-artwork, .process-step",
    ) ?? [],
  );
  let processIsStacking =
    processSection?.classList.contains("section-is-stacking") ?? false;
  const reduceProcessMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  function setProcessMotionVisibility(isVisible: boolean) {
    processMotionTargets.forEach((target) => {
      target.classList.toggle("is-visible", isVisible);
      target.classList.toggle("is-hidden", !isVisible);
    });
  }

  if (
    !reduceProcessMotion &&
    "IntersectionObserver" in window &&
    processMotionTargets.length
  ) {
    processMotionTargets.forEach((target) => target.classList.add("motion-ready"));
    const processMotionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (processIsStacking) return;
          entry.target.classList.toggle("is-visible", entry.isIntersecting);
          entry.target.classList.toggle("is-hidden", !entry.isIntersecting);
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );
    processMotionTargets.forEach((target) => processMotionObserver.observe(target));
  }

  processSection?.addEventListener("section-stack-state", (event) => {
    const stackEvent = event as CustomEvent<{ isStacking: boolean }>;
    if (reduceProcessMotion) return;
    processIsStacking = stackEvent.detail.isStacking;
    setProcessMotionVisibility(!stackEvent.detail.isStacking);
  });
</script>
