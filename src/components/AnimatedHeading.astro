---
interface Props {
  eyebrow: string;
  title: string;
  headingClass?: string;
}

const { eyebrow, title, headingClass = "" } = Astro.props;
---

<div class="mb-8">
  <p class="text-lg text-[var(--sec)] mb-2 shiny-sec">
    {Astro.currentLocale === "es" && eyebrow === "Service"
      ? "Servicios"
      : Astro.currentLocale === "es" && eyebrow === "About us"
        ? "Sobre nosotros"
        : Astro.currentLocale === "es" && eyebrow === "Harnessing Cutting-Edge"
          ? "Aprovechando la innovación"
          : Astro.currentLocale === "es" && eyebrow === "Measurable success"
            ? "Éxito medible"
            : Astro.currentLocale === "es" &&
                eyebrow === "The talent behind the engineering"
              ? "El talento detrás de la ingeniería"
              : Astro.currentLocale === "es" && eyebrow === "Real feedback"
                ? "Opiniones reales"
                : eyebrow}
  </p>
  <h2
    class={`display-heading font-display text-4xl md:text-5xl font-medium text-[var(--white)] ${headingClass}`}
    aria-label={title}
  >
    <span class="display-heading__visual" aria-hidden="true">
      {Array.from(title).map((character, index) =>
        character === " " ? (
          " "
        ) : (
          <span style={`--char-index: ${index}`}>{character}</span>
        ),
      )}
    </span>
  </h2>
</div>
