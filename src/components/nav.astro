---
interface NavItem {
  label: string;
  href: string;
  sections: string[];
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Home",
    href: "#home",
    sections: ["home"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/></svg>`,
  },
  {
    label: "About",
    href: "#about",
    sections: ["about", "services"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/></svg>`,
  },
  {
    label: "Service",
    href: "#advantages",
    sections: ["advantages", "process", "tools", "results", "team"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg>`,
  },
  {
    label: "Testimonials",
    href: "#testimonials",
    sections: ["testimonials"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg>`,
  },
  {
    label: "Projects",
    href: "#projects",
    sections: ["projects"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h6"/></svg>`,
  },
  {
    label: "Contact",
    href: "#contact",
    sections: ["contact"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>`,
  },
];
---

<header id="site-header" class="site-header">
  <a href="#home" class="nav-brand" aria-label="CODEsign Labs, home">
    <img
      src="/svg/iso_codesignlabs_2x.png"
      alt=""
      width="40"
      height="40"
      class="h-10 w-10 object-contain"
    />
    <span>
      CODEsign<span class="nav-brand__accent">Labs</span>
    </span>
  </a>

  <nav id="main-nav" aria-label="Main navigation">
    <ul class="nav-links">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="nav-link"
            data-sections={item.sections.join(" ")}
            style={`--nav-index: ${navItems.indexOf(item)}`}
          >
            <span class="nav-link__icon" aria-hidden="true">
              <fragment set:html={item.icon} />
            </span>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    top: 1rem;
    left: 50%;
    display: flex;
    width: min(1120px, calc(100% - 3rem));
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.6rem 1rem;
    border: 1px solid transparent;
    border-radius: 9999px;
    background: rgb(16 16 16 / 88%);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
    transition:
      background-color 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease,
      min-height 250ms ease;
  }

  .site-header.scrolling {
    min-height: 3.75rem;
    border-color: var(--white-icon-tr);
    background: rgb(23 23 23 / 94%);
    box-shadow: 0 12px 40px rgb(0 0 0 / 18%);
  }

  .nav-brand {
    display: inline-flex;
    min-width: max-content;
    align-items: center;
    gap: 0.55rem;
    color: var(--white);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .nav-brand__accent {
    color: var(--sec);
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.7rem, 1.8vw, 1.6rem);
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 0.1rem;
    color: var(--white-icon);
    font-size: 0.82rem;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 200ms ease;
  }

  html.motion-enabled .nav-brand,
  html.motion-enabled .nav-link {
    animation: nav-enter 550ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--nav-index, 0) * 55ms);
  }

  @keyframes nav-enter {
    from {
      opacity: 0;
      transform: translateY(-0.65rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: 0.25rem;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--sec);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--white);
  }

  .nav-link.active {
    text-shadow: 0 0 18px #a476ff66;
  }

  .nav-link.active::after {
    transform: scaleX(1);
  }

  .nav-link__icon {
    display: none;
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 1050px) {
    .site-header {
      width: calc(100% - 2rem);
      gap: 0.75rem;
      padding-inline: 0.75rem;
    }

    .nav-brand {
      gap: 0.35rem;
      font-size: 0.82rem;
    }

    .nav-brand img {
      width: 2rem;
      height: 2rem;
    }

    .nav-links {
      gap: clamp(0.55rem, 1vw, 0.9rem);
    }

    .nav-link {
      font-size: 0.72rem;
    }
  }

  @media (max-width: 767px) {
    .site-header {
      top: auto;
      bottom: 0;
      width: 100%;
      min-height: 4.5rem;
      padding: 0.5rem 0.35rem calc(0.5rem + env(safe-area-inset-bottom));
      border-color: var(--white-icon-tr);
      border-radius: 1rem 1rem 0 0;
      background: rgb(16 16 16 / 96%);
      transform: translateX(-50%);
    }

    .site-header.scrolling {
      min-height: 4.5rem;
      border-radius: 1rem 1rem 0 0;
    }

    .nav-brand {
      display: none;
    }

    #main-nav {
      width: 100%;
    }

    .nav-links {
      width: max-content;
      min-width: 100%;
      justify-content: flex-start;
      gap: 0.2rem;
    }

    .nav-links li {
      flex: 0 0 auto;
    }

    .nav-link {
      min-width: 3.8rem;
      min-height: 3.3rem;
      flex-direction: column;
      justify-content: center;
      gap: 0.25rem;
      padding: 0.2rem 0;
      font-size: clamp(0.55rem, 2.4vw, 0.68rem);
    }

    #main-nav {
      overflow-x: auto;
      scrollbar-width: none;
    }

    #main-nav::-webkit-scrollbar {
      display: none;
    }

    .nav-link::after {
      right: 20%;
      bottom: 0;
      left: 20%;
      height: 1px;
      transform-origin: center;
    }

    .nav-link__icon {
      display: block;
      width: 1.1rem;
      height: 1.1rem;
    }

    body {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  let rafId: number | null = null;

  function updateHeader() {
    header?.classList.toggle("scrolling", window.scrollY > 16);
    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (rafId === null) {
        rafId = requestAnimationFrame(updateHeader);
      }
    },
    { passive: true },
  );
  updateHeader();

  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
  const sections = document.querySelectorAll<HTMLElement>("section[id]");
  const mainNav = document.getElementById("main-nav");

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const activeSection = Array.from(navLinks).find((link) =>
          link.dataset.sections?.split(" ").includes(entry.target.id),
        );
        if (!activeSection) return;

        if (
          window.matchMedia("(max-width: 767px)").matches &&
          mainNav &&
          (activeSection.offsetLeft < mainNav.scrollLeft ||
            activeSection.offsetLeft + activeSection.offsetWidth >
              mainNav.scrollLeft + mainNav.clientWidth)
        ) {
          mainNav.scrollTo({
            left:
              activeSection.offsetLeft -
              mainNav.clientWidth / 2 +
              activeSection.offsetWidth / 2,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)")
              .matches
              ? "auto"
              : "smooth",
          });
        }

        navLinks.forEach((link) => {
          const isActive = link.dataset.sections
            ?.split(" ")
            .includes(entry.target.id);
          link.classList.toggle("active", isActive);
          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      });
    },
    { rootMargin: "-25% 0px -60% 0px", threshold: 0 },
  );

  sections.forEach((section) => sectionObserver.observe(section));

  const motionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle("is-visible", entry.isIntersecting);
      });
    },
    { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
  );

  document
    .querySelectorAll(".display-heading, .reveal, .reveal-media")
    .forEach((element) => motionObserver.observe(element));
</script>
