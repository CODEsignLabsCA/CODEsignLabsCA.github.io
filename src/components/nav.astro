---
interface NavItem {
  label: string;
  href: string;
  sections: string[];
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Home",
    href: "#home",
    sections: ["home"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/></svg>`,
  },
  {
    label: "About",
    href: "#about",
    sections: ["about"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/></svg>`,
  },
  {
    label: "Services",
    href: "#services",
    sections: ["services", "advantages", "process", "tools", "results", "team"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg>`,
  },
  {
    label: "Testimonials",
    href: "#testimonials",
    sections: ["testimonials"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg>`,
  },
  {
    label: "Projects",
    href: "#projects",
    sections: ["projects"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h6"/></svg>`,
  },
  {
    label: "Contact",
    href: "#contact",
    sections: ["contact", "closing"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>`,
  },
];
---

<nav id="main-nav" class="main-nav" aria-label="Main navigation">
  <ul class="nav-links">
    {navItems.map((item, index) => (
      <li>
        <a
          href={item.href}
          class="nav-link"
          data-sections={item.sections.join(" ")}
          style={`--nav-index: ${index}`}
        >
          <span class="nav-link__icon" aria-hidden="true">
            <fragment set:html={item.icon} />
          </span>
          <span class="nav-link__label">
            <span>{item.label}</span>
            <span class="nav-link__label-reserve" aria-hidden="true">{item.label}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .main-nav {
    position: fixed;
    z-index: 100;
    top: 1.5rem;
    left: 50%;
    width: 80%;
    min-height: 3.75rem;
    padding: 0.55rem 1.5rem;
    border: 1px solid transparent;
    border-radius: 9999px;
    background: rgb(16 16 16 / 88%);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
    transition:
      min-height 350ms ease,
      border-color 350ms ease,
      background-color 350ms ease,
      box-shadow 350ms ease;
  }

  .main-nav.scrolling {
    min-height: 3.35rem;
    border-color: var(--white-icon-tr);
    background: rgb(23 23 23 / 94%);
    box-shadow: 0 12px 40px rgb(0 0 0 / 18%);
  }

  .nav-links {
    display: flex;
    min-height: 2.6rem;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.55rem, 2vw, 1.75rem);
    list-style: none;
  }

  .nav-links li {
    flex: 0 0 auto;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    min-height: 2.6rem;
    align-items: center;
    gap: 0.45rem;
    color: var(--white-icon);
    font-size: 1rem;
    text-decoration: none;
    transition:
      color 250ms ease;
  }

  .nav-link:hover {
    color: var(--sec);
  }

  .nav-link.active {
    color: #97cc04;
  }

  .nav-link__label {
    display: grid;
    font-weight: 400;
  }

  .nav-link__label > span {
    grid-area: 1 / 1;
  }

  .nav-link__label-reserve {
    font-size: 1.16em;
    font-weight: 700;
    visibility: hidden;
  }

  .nav-link.active .nav-link__label > span:first-child {
    animation: focus-in-expand-fwd 650ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
    transform-style: preserve-3d;
    transform-origin: center;
  }

  .nav-link__icon {
    display: none;
    width: 1.2rem;
    height: 1.2rem;
  }

  html.motion-enabled .nav-link {
    animation: nav-enter 550ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--nav-index, 0) * 55ms);
  }

  @keyframes nav-enter {
    from {
      opacity: 0;
      transform: translateY(-0.65rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1050px) and (min-width: 768px) {
    .nav-links {
      gap: clamp(0.5rem, 1.3vw, 1rem);
    }

  }

  @keyframes focus-in-expand-fwd {
    0% {
      letter-spacing: -0.5em;
      transform: translateZ(-800px) scaleX(0.65);
      filter: blur(12px);
      opacity: 0;
    }

    100% {
      transform: translateZ(0) scaleX(1);
      letter-spacing: normal;
      filter: blur(0);
      opacity: 1;
    }
  }

  @media (max-width: 767px) {
    .main-nav,
    .main-nav.scrolling {
      top: auto;
      bottom: 0;
      width: 100%;
      min-height: 4.5rem;
      padding: 0.4rem 0.3rem calc(0.4rem + env(safe-area-inset-bottom));
      border-color: var(--white-icon-tr);
      border-radius: 1rem 1rem 0 0;
      background: rgb(16 16 16 / 96%);
      transform: translateX(-50%);
    }

    .nav-links {
      width: 100%;
      min-height: 3.5rem;
      justify-content: space-around;
      gap: 0.1rem;
    }

    .nav-links li {
      flex: 1 1 0;
      min-width: 0;
    }

    .nav-link {
      width: 100%;
      min-height: 3.3rem;
      flex-direction: column;
      justify-content: center;
      gap: 0.22rem;
      font-size: clamp(0.48rem, 2.25vw, 0.65rem);
      white-space: nowrap;
    }

    .nav-link__icon {
      display: block;
    }

    body {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link.active .nav-link__label > span:first-child {
      animation: none;
    }
  }
</style>

<script>
  const mainNav = document.getElementById("main-nav");
  const navList = mainNav?.querySelector<HTMLElement>(".nav-links");
  const navItems = Array.from(
    navList?.querySelectorAll<HTMLElement>("li") ?? [],
  );
  let rafId: number | null = null;

  function getRequiredNavWidth() {
    if (!mainNav || !navList || navItems.length === 0) return 528;

    const navStyle = getComputedStyle(mainNav);
    const listStyle = getComputedStyle(navList);
    const itemWidth = navItems.reduce(
      (width, item) => width + item.getBoundingClientRect().width,
      0,
    );
    const gap = Number.parseFloat(listStyle.columnGap) || 0;
    const horizontalPadding =
      (Number.parseFloat(navStyle.paddingLeft) || 0) +
      (Number.parseFloat(navStyle.paddingRight) || 0);
    const borderWidth =
      (Number.parseFloat(navStyle.borderLeftWidth) || 0) +
      (Number.parseFloat(navStyle.borderRightWidth) || 0);

    return Math.max(
      528,
      itemWidth + gap * Math.max(0, navItems.length - 1) + horizontalPadding + borderWidth,
    );
  }

  function updateNav() {
    const scrollY = window.scrollY;
    const isScrolled = scrollY > 0;
    mainNav?.classList.toggle("scrolling", isScrolled);

    if (mainNav && window.innerWidth >= 768 && isScrolled) {
      const maxWidth = window.innerWidth - 32;
      const endWidth = Math.min(getRequiredNavWidth(), maxWidth);
      const startWidth = Math.min(
        Math.max(window.innerWidth * 0.8, endWidth),
        maxWidth,
      );
      const progress = window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ? 1
        : 1 - (1 - Math.min(scrollY / 1000, 1)) ** 4;
      const width = startWidth - (startWidth - endWidth) * progress;
      mainNav.style.width = `${width}px`;
    } else {
      mainNav?.style.removeProperty("width");
    }

    rafId = null;
  }

  function scheduleNavUpdate() {
    if (rafId === null) {
      rafId = requestAnimationFrame(updateNav);
    }
  }

  window.addEventListener(
    "scroll",
    scheduleNavUpdate,
    { passive: true },
  );
  window.addEventListener("resize", scheduleNavUpdate, { passive: true });
  updateNav();

  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
  const sections = document.querySelectorAll<HTMLElement>("section[id]");
  const activeSectionIds = new Set<string>();

  function updateActiveLink(sectionId: string) {
    navLinks.forEach((link) => {
      const isActive = link.dataset.sections?.split(" ").includes(sectionId);
      link.classList.toggle("active", Boolean(isActive));

      if (isActive) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });

    scheduleNavUpdate();
  }

  function chooseActiveSection() {
    const activeSections = Array.from(activeSectionIds)
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section !== null);

    if (activeSections.length === 0) return;

    const targetLine = window.innerHeight * 0.38;
    activeSections.sort(
      (a, b) =>
        Math.abs(a.getBoundingClientRect().top - targetLine) -
        Math.abs(b.getBoundingClientRect().top - targetLine),
    );
    updateActiveLink(activeSections[0].id);
  }

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          activeSectionIds.add(entry.target.id);
        } else {
          activeSectionIds.delete(entry.target.id);
        }
      });

      chooseActiveSection();
    },
    { rootMargin: "-25% 0px -55% 0px", threshold: 0 },
  );

  sections.forEach((section) => sectionObserver.observe(section));

  const motionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle("is-visible", entry.isIntersecting);
      });
    },
    { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
  );

  document
    .querySelectorAll(".display-heading, .reveal, .reveal-media")
    .forEach((element) => motionObserver.observe(element));
</script>
