---
interface NavItem {
  label: string;
  href: string;
  sections: string[];
}

const navItems: NavItem[] = [
  { label: "Home", href: "#home", sections: ["home"] },
  { label: "About", href: "#about", sections: ["about"] },
  {
    label: "Services",
    href: "#services",
    sections: ["services", "advantages", "process", "tools", "results", "team"],
  },
  {
    label: "Testimonials",
    href: "#testimonials",
    sections: ["testimonials"],
  },
  { label: "Projects", href: "#projects", sections: ["projects"] },
  { label: "Contact", href: "#contact", sections: ["contact", "closing"] },
];
---

<header id="site-header" class="site-header">
  <a href="#home" class="nav-brand" aria-label="CODEsign Labs, home">
    <img
      src="/svg/iso_codesignlabs_2x.png"
      alt=""
      width="40"
      height="40"
      class="nav-brand__logo"
    />
    <span>CODEsign<span class="nav-brand__accent">Labs</span></span>
  </a>

  <div class="header-actions">
    <a class="header-contact" href="#contact">
      Let's talk <span aria-hidden="true">↗</span>
    </a>
    <button
      id="menu-trigger"
      class="menu-trigger"
      type="button"
      aria-controls="menu-dialog"
      aria-expanded="false"
      aria-label="Open navigation menu"
    >
      <span class="menu-trigger__label">Menu</span>
      <span class="menu-trigger__icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>
</header>

<nav id="section-rail" class="section-rail" aria-label="Section navigation" hidden>
  <ul>
    {navItems.map((item, index) => (
      <li>
        <a
          href={item.href}
          class="rail-link"
          data-sections={item.sections.join(" ")}
          aria-label={item.label}
          style={`--rail-index: ${index}`}
        >
          <span class="rail-link__number">{String(index + 1).padStart(2, "0")}</span>
          <span class="rail-link__label" aria-hidden="true">
            <span>{item.label}</span>
            <span>{item.label}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<dialog id="menu-dialog" class="menu-dialog" aria-label="Navigation menu">
  <div class="menu-drawer">
    <div class="menu-drawer__top">
      <p class="menu-drawer__eyebrow">CODEsignLabs <span>— Navigation</span></p>
      <button
        id="menu-close"
        class="menu-close"
        type="button"
        aria-label="Close navigation menu"
      >
        <span>Close</span>
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <nav aria-label="Main navigation">
      <ul class="drawer-links">
        {navItems.map((item, index) => (
          <li>
            <a
              href={item.href}
              class="drawer-link"
              data-sections={item.sections.join(" ")}
              style={`--drawer-index: ${index}`}
            >
              <span class="drawer-link__number">{String(index + 1).padStart(2, "0")}</span>
              <span class="drawer-link__label">{item.label}</span>
              <span class="drawer-link__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="menu-drawer__footer">Thoughtful digital experiences, built to last.</p>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem clamp(1.25rem, 5vw, 5rem);
    border-bottom: 1px solid transparent;
    background: rgb(16 16 16 / 72%);
    backdrop-filter: blur(18px);
    transition:
      min-height 250ms ease,
      border-color 250ms ease,
      background-color 250ms ease;
  }

  .site-header.scrolling {
    min-height: 4.25rem;
    border-color: var(--white-icon-tr);
    background: rgb(16 16 16 / 92%);
  }

  .nav-brand {
    display: inline-flex;
    min-width: max-content;
    align-items: center;
    gap: 0.55rem;
    color: var(--white);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .nav-brand__logo {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }

  .nav-brand__accent {
    color: var(--sec);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3rem);
  }

  .header-contact,
  .menu-trigger {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--white);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .header-contact {
    transition: color 200ms ease;
  }

  .header-contact:hover {
    color: var(--sec);
  }

  .header-contact span {
    color: var(--sec);
    font-size: 1rem;
  }

  .menu-trigger {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .menu-trigger__icon {
    display: grid;
    width: 1.25rem;
    gap: 0.35rem;
  }

  .menu-trigger__icon span {
    width: 100%;
    height: 1px;
    background: var(--sec);
    transition:
      transform 250ms ease,
      width 250ms ease;
  }

  .menu-trigger__icon span:last-child {
    width: 70%;
    justify-self: end;
  }

  .menu-trigger:hover .menu-trigger__icon span:last-child {
    width: 100%;
  }

  .menu-trigger[aria-expanded="true"] .menu-trigger__icon span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .menu-trigger[aria-expanded="true"] .menu-trigger__icon span:last-child {
    width: 100%;
    transform: translateY(-3px) rotate(-45deg);
  }

  .section-rail {
    position: fixed;
    z-index: 80;
    top: 50%;
    right: clamp(1rem, 2.4vw, 2.5rem);
    width: 8.5rem;
    padding: 0.8rem 0.65rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 1rem;
    background: rgb(16 16 16 / 78%);
    backdrop-filter: blur(16px);
    opacity: 0;
    transform: translate(1rem, -50%);
    transition:
      opacity 350ms ease,
      transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }

  .section-rail[hidden] {
    display: block;
    visibility: hidden;
  }

  .section-rail.is-visible {
    visibility: visible;
    opacity: 1;
    transform: translate(0, -50%);
    pointer-events: auto;
  }

  .section-rail ul,
  .drawer-links {
    display: grid;
    list-style: none;
  }

  .rail-link {
    display: flex;
    min-height: 2.7rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.4rem;
    color: var(--white-icon);
    font-size: 0.69rem;
    text-decoration: none;
    transition: color 250ms ease;
  }

  .rail-link__number,
  .drawer-link__number {
    color: var(--white-icon);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    transition: color 250ms ease;
  }

  .rail-link__label {
    display: grid;
    height: 1.1em;
    overflow: hidden;
    line-height: 1.1;
  }

  .rail-link__label span {
    transition: transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .rail-link:hover,
  .rail-link.active {
    color: var(--white);
  }

  .rail-link:hover .rail-link__number,
  .rail-link.active .rail-link__number {
    color: var(--sec);
  }

  .rail-link:hover .rail-link__label span,
  .rail-link.active .rail-link__label span {
    transform: translateY(-100%);
  }

  .menu-dialog {
    position: fixed;
    z-index: 200;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    color: var(--white);
  }

  .menu-dialog::backdrop {
    background: rgb(0 0 0 / 55%);
    backdrop-filter: blur(8px);
    animation: backdrop-in 300ms ease both;
  }

  .menu-drawer {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    width: min(36rem, 88vw);
    height: 100%;
    flex-direction: column;
    padding: clamp(1.5rem, 5vw, 4rem);
    border-left: 1px solid var(--white-icon-tr);
    background:
      radial-gradient(ellipse at 100% 0%, rgb(164 118 255 / 12%), transparent 48%),
      #101010;
    animation: drawer-in 450ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .menu-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .menu-drawer__eyebrow,
  .menu-drawer__footer {
    color: var(--white-icon);
    font-size: 0.67rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .menu-drawer__eyebrow span {
    color: var(--sec);
  }

  .menu-close {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.35rem 0;
    border: 0;
    background: transparent;
    color: var(--white);
    cursor: pointer;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .menu-close span:last-child {
    color: var(--sec);
    font-size: 1.8rem;
    line-height: 0.7;
  }

  .drawer-links {
    margin: auto 0;
    border-top: 1px solid var(--white-icon-tr);
  }

  .drawer-links li {
    border-bottom: 1px solid var(--white-icon-tr);
  }

  .drawer-link {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: clamp(0.8rem, 2.5vh, 1.4rem) 0;
    color: var(--white-icon);
    text-decoration: none;
    transition:
      color 250ms ease,
      padding-left 350ms cubic-bezier(0.2, 0.7, 0.2, 1);
    animation: drawer-link-in 450ms both;
    animation-delay: calc(120ms + var(--drawer-index) * 55ms);
  }

  .drawer-link__label {
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
  }

  .drawer-link__arrow {
    color: var(--sec);
    font-size: 1.25rem;
    opacity: 0;
    transform: translate(-0.4rem, 0.4rem);
    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }

  .drawer-link:hover,
  .drawer-link.active {
    padding-left: 0.65rem;
    color: var(--white);
  }

  .drawer-link:hover .drawer-link__number,
  .drawer-link.active .drawer-link__number {
    color: var(--sec);
  }

  .drawer-link:hover .drawer-link__arrow,
  .drawer-link.active .drawer-link__arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .menu-drawer__footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--white-icon-tr);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  @keyframes drawer-in {
    from {
      opacity: 0.65;
      transform: translateX(4rem);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes drawer-link-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes backdrop-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  html.motion-enabled .nav-brand,
  html.motion-enabled .header-actions {
    animation: nav-enter 550ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  html.motion-enabled .header-actions {
    animation-delay: 80ms;
  }

  @keyframes nav-enter {
    from {
      opacity: 0;
      transform: translateY(-0.65rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .site-header {
      min-height: 4.25rem;
      padding-inline: 1rem;
    }

    .site-header.scrolling {
      min-height: 3.75rem;
    }

    .nav-brand {
      gap: 0.4rem;
      font-size: 0.82rem;
    }

    .nav-brand__logo {
      width: 2rem;
      height: 2rem;
    }

    .header-actions {
      gap: 1rem;
    }

    .header-contact,
    .menu-trigger {
      min-height: 2.5rem;
      font-size: 0.64rem;
    }

    .section-rail {
      display: none;
    }

    .menu-drawer {
      width: 100%;
      padding: 1.25rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    }

    .drawer-link__label {
      font-size: clamp(1.8rem, 8vw, 2.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-dialog::backdrop,
    .menu-drawer,
    .drawer-link {
      animation: none;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const menuTrigger = document.getElementById(
    "menu-trigger",
  ) as HTMLButtonElement | null;
  const menuDialog = document.getElementById(
    "menu-dialog",
  ) as HTMLDialogElement | null;
  const menuClose = document.getElementById(
    "menu-close",
  ) as HTMLButtonElement | null;
  const sectionRail = document.getElementById("section-rail");
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(
    ".rail-link, .drawer-link",
  );
  const sections = document.querySelectorAll<HTMLElement>("section[id]");
  const activeSectionIds = new Set<string>();
  const navGroups = Array.from(document.querySelectorAll<HTMLAnchorElement>(".rail-link"));
  let rafId: number | null = null;

  function updateHeader() {
    header?.classList.toggle("scrolling", window.scrollY > 16);
    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (rafId === null) {
        rafId = requestAnimationFrame(updateHeader);
      }
    },
    { passive: true },
  );
  updateHeader();

  function updateActiveNavigation(sectionId: string) {
    let activeGroupIndex = -1;

    navLinks.forEach((link) => {
      const isActive = link.dataset.sections?.split(" ").includes(sectionId);
      link.classList.toggle("active", Boolean(isActive));

      if (isActive) {
        link.setAttribute("aria-current", "location");
      } else {
        link.removeAttribute("aria-current");
      }
    });

    navGroups.forEach((link, index) => {
      if (link.dataset.sections?.split(" ").includes(sectionId)) {
        activeGroupIndex = index;
      }
    });

    sectionRail?.classList.toggle("is-visible", activeGroupIndex >= 2);
    if (sectionRail) {
      sectionRail.toggleAttribute("hidden", activeGroupIndex < 2);
    }
  }

  function chooseActiveSection() {
    const activeSections = Array.from(activeSectionIds)
      .map((id) => document.getElementById(id))
      .filter((section): section is HTMLElement => section !== null);

    if (activeSections.length === 0) return;

    const targetLine = window.innerHeight * 0.38;
    activeSections.sort(
      (a, b) =>
        Math.abs(a.getBoundingClientRect().top - targetLine) -
        Math.abs(b.getBoundingClientRect().top - targetLine),
    );
    updateActiveNavigation(activeSections[0].id);
  }

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          activeSectionIds.add(entry.target.id);
        } else {
          activeSectionIds.delete(entry.target.id);
        }
      });

      chooseActiveSection();
    },
    { rootMargin: "-25% 0px -55% 0px", threshold: 0 },
  );

  sections.forEach((section) => sectionObserver.observe(section));

  menuTrigger?.addEventListener("click", () => {
    if (!menuDialog?.open) {
      menuDialog?.showModal();
      menuTrigger.setAttribute("aria-expanded", "true");
      menuTrigger.setAttribute("aria-label", "Close navigation menu");
    }
  });

  function closeMenu() {
    if (!menuDialog?.open) return;
    menuDialog.close();
    menuTrigger?.setAttribute("aria-expanded", "false");
    menuTrigger?.setAttribute("aria-label", "Open navigation menu");
  }

  menuClose?.addEventListener("click", closeMenu);
  menuDialog?.addEventListener("close", () => {
    menuTrigger?.setAttribute("aria-expanded", "false");
    menuTrigger?.setAttribute("aria-label", "Open navigation menu");
  });
  menuDialog?.addEventListener("click", (event) => {
    if (event.target === menuDialog) closeMenu();
  });
  menuDialog?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  const motionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle("is-visible", entry.isIntersecting);
      });
    },
    { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
  );

  document
    .querySelectorAll(".display-heading, .reveal, .reveal-media")
    .forEach((element) => motionObserver.observe(element));
</script>
