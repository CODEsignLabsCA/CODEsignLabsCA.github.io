---
import AnimatedHeading from "./AnimatedHeading.astro";

const services = [
  {
    number: "01",
    title: "Multiplatform Mobile Engineering",
    stack: "Flutter, Dart, Kotlin Multiplatform, Swift.",
    label: "Return",
    outcome: "Monetizable, native apps with a fast time-to-market.",
  },
  {
    number: "02",
    title: "Infraestructura Web & Backend",
    stack: "PostgreSQL, MySQL, TypeScript, JavaScript.",
    label: "Outcome",
    outcome: "High-demand architectures with optimized costs.",
  },
];
---

<section
  id="services"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading
      eyebrow="Service"
      title="Our comprehensive range of software development"
    />
    <p class="max-w-3xl mb-10 text-lg leading-relaxed text-[var(--white-icon)]">
      We develop multi-platform digital ecosystems designed to open new sales
      channels and diversify your company’s revenue streams.
    </p>

    <div class="mb-8 grid gap-4 md:grid-cols-[auto_1fr] md:items-center">
      <div class="rounded-2xl bg-[var(--component-bg)] px-7 py-5 text-center">
        <p class="text-4xl font-semibold text-[var(--sec)]">71,2%</p>
        <p class="mt-2 text-[var(--white-icon)]">Custom Software Development</p>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {services.map((service) => (
        <article class="service-card reveal group rounded-2xl border border-[var(--white-icon-tr)] bg-[var(--component-bg)] p-6 md:p-7 transition duration-300 hover:-translate-y-1 hover:border-[var(--sec)]">
          <p class="text-sm tracking-[0.2em] text-[var(--sec)]">
            {service.number}
          </p>
          <h3 class="mt-8 text-2xl font-medium leading-snug">
            {service.title}
          </h3>
          <p class="mt-4 leading-relaxed text-[var(--white-icon)]">
            <strong class="text-[var(--white)]">Stack:</strong> {service.stack}
          </p>
          <p class="mt-4 leading-relaxed text-[var(--white-icon)]">
            <strong class="text-[var(--white)]">{service.label}:</strong>{" "}
            {service.outcome}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
