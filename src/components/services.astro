---
import AnimatedHeading from "./AnimatedHeading.astro";

const services = [
  {
    number: "01",
    title: "Multiplatform Mobile Engineering",
    stack: "Flutter, Dart, Kotlin Multiplatform, Swift.",
    label: "Return",
    outcome: "Monetizable, native apps with a fast time-to-market.",
  },
  {
    number: "02",
    title: "Infraestructura Web & Backend",
    stack: "PostgreSQL, MySQL, TypeScript, JavaScript.",
    label: "Outcome",
    outcome: "High-demand architectures with optimized costs.",
  },
];
---

<section
  id="services"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading
      eyebrow="Service"
      title="Our comprehensive range of software development"
    />
    <p class="max-w-3xl mb-10 text-lg leading-relaxed text-[var(--white-icon)]">
      We develop multi-platform digital ecosystems designed to open new sales
      channels and diversify your company’s revenue streams.
    </p>

    <div class="service-overview mb-8 grid items-center gap-6 md:grid-cols-[minmax(14rem,0.65fr)_1fr]">
      <figure class="service-overview__image overflow-hidden">
        <img
          src="/images/service-sections/Our Comprehensive Range of Software Development.webp"
          alt="A mobile app and software development workspace in a custom neon frame"
          class="h-full w-full object-contain"
          width="453"
          height="654"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="service-overview__stat reveal rounded-2xl bg-[var(--component-bg)] px-7 py-5 text-center md:text-left">
        <p class="text-4xl font-semibold text-[var(--sec)]">
          <span data-count-up="71.2">71,2</span>%
        </p>
        <p class="mt-2 text-[var(--white-icon)]">Custom Software Development</p>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {services.map((service) => (
        <article class="service-card reveal group rounded-2xl border border-[var(--white-icon-tr)] bg-[var(--component-bg)] p-6 md:p-7 transition duration-300 hover:-translate-y-1 hover:border-[var(--sec)]">
          <p class="text-sm tracking-[0.2em] text-[var(--sec)]">
            {service.number}
          </p>
          <h3 class="mt-8 text-2xl font-medium leading-snug">
            {service.title}
          </h3>
          <p class="mt-4 leading-relaxed text-[var(--white-icon)]">
            <strong class="text-[var(--white)]">Stack:</strong> {service.stack}
          </p>
          <p class="mt-4 leading-relaxed text-[var(--white-icon)]">
            <strong class="text-[var(--white)]">{service.label}:</strong>{" "}
            {service.outcome}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .service-overview__image {
    display: flex;
    height: 22rem;
    align-items: center;
    justify-content: center;
    background: transparent;
    clip-path: inset(0 100% 0 0);
    opacity: 0;
    transform: translateX(-1.5rem);
    transition:
      clip-path 850ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 450ms ease,
      transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: clip-path, opacity, transform;
  }

  .service-overview__image img {
    max-height: 100%;
    transform: scale(1.08);
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .service-overview__image.is-visible {
    clip-path: inset(0);
    opacity: 1;
    transform: translateX(0);
  }

  .service-overview__image.is-visible img {
    transform: scale(1);
  }

  @media (max-width: 767px) {
    .service-overview__image {
      height: 20rem;
    }

    .service-overview__image img {
      max-height: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-overview__image,
    .service-overview__image img {
      clip-path: none;
      opacity: 1;
      transform: none;
      transition: none;
      will-change: auto;
    }
  }
</style>

<script>
  const serviceOverviewImage = document.querySelector<HTMLElement>(
    ".service-overview__image",
  );
  const serviceOverviewImageObserver = new IntersectionObserver(
    ([entry]) => {
      serviceOverviewImage?.classList.toggle("is-visible", entry.isIntersecting);
    },
    { threshold: 0.15 },
  );

  if (serviceOverviewImage) {
    serviceOverviewImageObserver.observe(serviceOverviewImage);
  }

  const countUpElement = document.querySelector<HTMLElement>("[data-count-up]");
  const countTarget = Number(countUpElement?.dataset.countUp);
  let countAnimationFrame: number | null = null;

  function renderCount(value: number) {
    if (countUpElement) {
      countUpElement.textContent = value.toFixed(1).replace(".", ",");
    }
  }

  const countObserver = new IntersectionObserver(
    ([entry]) => {
      if (!countUpElement || !Number.isFinite(countTarget)) return;

      if (!entry.isIntersecting) {
        if (countAnimationFrame !== null) {
          cancelAnimationFrame(countAnimationFrame);
          countAnimationFrame = null;
        }
        renderCount(0);
        return;
      }

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        renderCount(countTarget);
        return;
      }

      if (countAnimationFrame !== null) {
        cancelAnimationFrame(countAnimationFrame);
      }

      const duration = 1400;
      const startTime = performance.now();
      const animateCount = (now: number) => {
        const progress = Math.min((now - startTime) / duration, 1);
        const easedProgress = 1 - (1 - progress) ** 3;
        renderCount(countTarget * easedProgress);

        if (progress < 1) {
          countAnimationFrame = requestAnimationFrame(animateCount);
        } else {
          countAnimationFrame = null;
        }
      };

      countAnimationFrame = requestAnimationFrame(animateCount);
    },
    { threshold: 0.5 },
  );

  if (countUpElement) countObserver.observe(countUpElement);
</script>
