---
import AnimatedHeading from "./AnimatedHeading.astro";

const services = [
  {
    number: "01",
    title: "Multiplatform Mobile Engineering",
    stack: "Flutter, Dart, Kotlin Multiplatform, Swift.",
    label: "Return",
    outcome: "Monetizable, native apps with a fast time-to-market.",
  },
  {
    number: "02",
    title: "Web & Backend Infrastructure",
    stack: "PostgreSQL, MySQL, TypeScript, JavaScript.",
    label: "Outcome",
    outcome: "High-demand architectures with optimized costs.",
  },
];
---

<section
  id="services"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <div class="service-overview">
      <figure class="service-overview__image">
        <img
          src="/images/service-sections/Our Comprehensive Range of Software Development.webp"
          alt="A mobile app and software development workspace in a custom neon frame"
          width="453"
          height="654"
          loading="lazy"
          decoding="async"
        />
        <div class="service-overview__stat" aria-label="71.2 percent: Custom Software Development">
          <p class="service-overview__percentage">
            <span data-count-up="71.2">71,2</span>%
          </p>
          <p class="service-overview__caption">Custom Software Development</p>
        </div>
      </figure>

      <div class="service-overview__content">
        <AnimatedHeading
          eyebrow="Service"
          title="Our comprehensive range of software development"
        />
        <p class="mb-6 text-base leading-relaxed text-[var(--white-icon)] md:text-lg">
          We develop multi-platform digital ecosystems designed to open new sales
          channels and diversify your company’s revenue streams.
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
          {services.map((service) => (
            <article class="service-card reveal group rounded-2xl border border-[var(--white-icon-tr)] bg-[var(--component-bg)] p-5 transition duration-300 hover:-translate-y-1 hover:border-[var(--sec)] md:p-6">
              <p class="text-sm tracking-[0.2em] text-[var(--sec)]">
                {service.number}
              </p>
              <h3 class="mt-5 text-xl font-medium leading-snug">
                {service.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--white-icon)]">
                <strong class="text-[var(--white)]">Stack:</strong> {service.stack}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--white-icon)]">
                <strong class="text-[var(--white)]">{service.label}:</strong>{" "}
                {service.outcome}
              </p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .service-overview {
    display: grid;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .service-overview__image {
    position: relative;
    display: flex;
    min-height: 30rem;
    align-items: center;
    justify-content: center;
    margin: 0;
    background: transparent;
  }

  .service-overview__image > img {
    display: block;
    width: min(100%, 22rem);
    height: auto;
    object-fit: contain;
  }

  .service-overview__image.is-visible > img {
    animation: service-image-enter 850ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .service-overview__image.is-visible .service-overview__stat {
    animation: service-stat-enter 700ms 180ms cubic-bezier(0.2, 0.7, 0.2, 1)
      both;
  }

  .service-overview__image.is-hidden > img {
    animation: service-image-exit 600ms cubic-bezier(0.4, 0, 0.8, 0.3) both;
  }

  .service-overview__image.is-hidden .service-overview__stat {
    animation: service-stat-exit 450ms cubic-bezier(0.4, 0, 0.8, 0.3) both;
  }

  @keyframes service-image-enter {
    from {
      clip-path: inset(0 100% 0 0);
      opacity: 0;
      transform: translateX(-1.5rem);
    }

    to {
      clip-path: inset(0);
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes service-stat-enter {
    from {
      opacity: 0;
      transform: translateX(-2rem);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes service-image-exit {
    from {
      clip-path: inset(0);
      opacity: 1;
      transform: translateX(0);
    }

    to {
      clip-path: inset(0 100% 0 0);
      opacity: 0;
      transform: translateX(-1.5rem);
    }
  }

  @keyframes service-stat-exit {
    from {
      opacity: 1;
      transform: translateX(0);
    }

    to {
      opacity: 0;
      transform: translateX(-2rem);
    }
  }

  .service-overview__stat {
    position: absolute;
    z-index: 1;
    top: 13%;
    right: -1.25rem;
    left: auto;
    width: 10.75rem;
    min-height: 7rem;
    padding: 1rem 1.15rem;
    border-radius: 0.85rem;
    background: #263438;
    box-shadow: 0 12px 32px rgb(0 0 0 / 24%);
  }

  .service-overview__percentage {
    color: #9985f9;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .service-overview__caption {
    margin-top: 0.55rem;
    color: var(--white-icon);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .service-overview {
      grid-template-columns: minmax(15rem, 0.72fr) minmax(0, 1.28fr);
    }
  }

  @media (max-width: 767px) {
    .service-overview__image {
      min-height: 24rem;
    }

    .service-overview__image > img {
      width: min(82%, 20rem);
    }

    .service-overview__stat {
      top: 12%;
      right: 0;
      width: 10rem;
      min-height: 0;
      padding: 0.85rem 1rem;
    }

    .service-overview__percentage {
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-overview__image.is-visible > img,
    .service-overview__image.is-visible .service-overview__stat,
    .service-overview__image.is-hidden > img,
    .service-overview__image.is-hidden .service-overview__stat {
      clip-path: none;
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  const serviceOverviewImage = document.querySelector<HTMLElement>(
    ".service-overview__image",
  );
  const serviceSection = document.querySelector<HTMLElement>("#services");

  function showServiceVisual() {
    serviceOverviewImage?.classList.remove("is-hidden");
    serviceOverviewImage?.classList.add("is-visible");
  }

  function hideServiceVisual() {
    serviceOverviewImage?.classList.remove("is-visible");
    serviceOverviewImage?.classList.add("is-hidden");
  }

  if ("IntersectionObserver" in window && serviceOverviewImage) {
    const serviceOverviewImageObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        showServiceVisual();
      },
      { threshold: 0.15 },
    );
    serviceOverviewImageObserver.observe(serviceOverviewImage);
  }

  const countUpElement = document.querySelector<HTMLElement>("[data-count-up]");
  const countTarget = Number(countUpElement?.dataset.countUp);

  function renderCount(value: number) {
    if (countUpElement) {
      countUpElement.textContent = value.toFixed(1).replace(".", ",");
    }
  }

  let countAnimationFrame: number | null = null;
  let countWasVisible = false;

  function resetCount() {
    if (countAnimationFrame !== null) {
      cancelAnimationFrame(countAnimationFrame);
      countAnimationFrame = null;
    }
    renderCount(0);
  }

  function animateCount() {
    if (!countUpElement || !Number.isFinite(countTarget)) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      renderCount(countTarget);
      return;
    }

    if (countAnimationFrame !== null) {
      cancelAnimationFrame(countAnimationFrame);
    }
    renderCount(0);

    const duration = 1400;
    const startTime = performance.now();
    const animate = (now: number) => {
      const progress = Math.min((now - startTime) / duration, 1);
      const easedProgress = 1 - (1 - progress) ** 3;
      renderCount(countTarget * easedProgress);

      if (progress < 1) {
        countAnimationFrame = requestAnimationFrame(animate);
      } else {
        countAnimationFrame = null;
        renderCount(countTarget);
      }
    };

    countAnimationFrame = requestAnimationFrame(animate);
  }

  serviceSection?.addEventListener("service-stack-state", (event) => {
    const stackEvent = event as CustomEvent<{ isStacking: boolean }>;
    if (stackEvent.detail.isStacking) {
      hideServiceVisual();
      resetCount();
    } else {
      showServiceVisual();
      animateCount();
    }
  });

  if (countUpElement && Number.isFinite(countTarget)) {
    renderCount(0);
  }

  if (
    countUpElement &&
    Number.isFinite(countTarget) &&
    "IntersectionObserver" in window
  ) {
    const countObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) {
          if (!countWasVisible) return;
          resetCount();
          return;
        }

        countWasVisible = true;
        animateCount();
      },
      { threshold: 0.01 },
    );
    countObserver.observe(countUpElement);
  } else if (countUpElement && Number.isFinite(countTarget)) {
    renderCount(countTarget);
  }
</script>
