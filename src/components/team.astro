---
import AnimatedHeading from "./AnimatedHeading.astro";
---

<section
  id="team"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading
      eyebrow="The talent behind the engineering"
      title="From Idea to Market Leadership: Architecting digital products that reshape industries and drive meaningful growth."
      headingClass="team-heading text-center uppercase"
    />

    <article class="team-profile reveal mx-auto grid max-w-4xl items-center gap-6 md:grid-cols-[minmax(16rem,0.8fr)_1.2fr] md:gap-12">
      <div class="profile-frame team-photo reveal-media mx-auto w-full max-w-[17rem]">
        <img
          src="/images/service-sections/The%20Brain%20Behind%20the%20Engineering.webp"
          alt="Jairo Fernando Ramos G"
          class="team-photo__image reveal-media__image aspect-[441/408] w-full rounded-xl object-cover"
          width="441"
          height="408"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="team-profile__content">
        <h3 class="text-2xl font-medium">Jairo Fernando Ramos G</h3>
        <p class="mt-2 text-lg font-bold text-[var(--sec)]">
          Lead Product & Full-Stack Architect
        </p>
        <ul class="team-expertise mt-2 space-y-5">
          <li>
            <strong>Product Design:</strong>{" "}
            Specialist in conceptualizing interactive{" "}
            <strong class="text-[#97CC04]">
              MVPS in Figma using the Stitch
            </strong>{" "}
            modular design system.
          </li>
          <li>
            <strong>
              Cross-Platform Engineering:
            </strong>{" "}
            Architecture and native deployment using{" "}
            <strong class="text-[#97CC04]">
              Kotlin Multiplatform, Flutter, Dart, and Swift.
            </strong>
          </li>
          <li>
            <strong>Business Strategy:</strong>{" "}
            Robust data integration using{" "}
            <strong class="text-[#97CC04]">
              PostgreSQL and Supabase, combined with advanced AI automation
            </strong>{" "}
            to unlock new corporate revenue streams.
          </li>
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  .team-heading {
    max-width: 58rem;
    margin-inline: auto;
    font-size: clamp(1.2rem, 2.4vw, 1.65rem) !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
  }

  .team-profile {
    max-width: 52rem;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
  }

  .team-expertise {
    color: var(--white-icon);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .profile-frame {
    padding: 0;
  }

  html.motion-enabled .team-photo.reveal-media:not(.is-visible) .team-photo__image {
    clip-path: inset(0 100% 0 0);
    transform: none;
  }

  html.motion-enabled .team-photo.reveal-media.is-visible .team-photo__image {
    clip-path: inset(0);
    transform: none;
  }

  html.motion-enabled .team-photo__image {
    transition:
      clip-path 850ms cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 850ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (max-width: 767px) {
    .team-profile {
      grid-template-columns: minmax(0, 1fr);
    }

    .team-profile__content {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-photo__image {
      clip-path: none;
      transform: none;
      transition: none;
    }
  }
</style>
