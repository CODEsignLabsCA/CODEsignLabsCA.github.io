---
import AnimatedHeading from "./AnimatedHeading.astro";

const isSpanish = Astro.currentLocale === "es";
---

<section
  id="team"
  class="scroll-mt-28 py-16 md:py-20 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <AnimatedHeading
      eyebrow={
        isSpanish
          ? "El talento detrás de la ingeniería"
          : "The talent behind the engineering"
      }
      title={
        isSpanish
          ? "De la idea al liderazgo del mercado: productos digitales que transforman industrias e impulsan un crecimiento significativo."
          : "From Idea to Market Leadership: Architecting digital products that reshape industries and drive meaningful growth."
      }
      headingClass="team-heading text-center uppercase"
    />

    <article class="team-profile reveal mx-auto grid max-w-4xl items-center gap-6 md:grid-cols-[minmax(16rem,0.8fr)_1.2fr] md:gap-12">
      <div class="profile-frame team-photo reveal-media mx-auto w-full max-w-[17rem]">
        <img
          src="/images/service-sections/The%20Brain%20Behind%20the%20Engineering.webp"
          alt="Jairo Fernando Ramos G"
          class="team-photo__image reveal-media__image aspect-[441/408] w-full rounded-xl object-cover"
          width="441"
          height="408"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="team-profile__content">
        <h3 class="text-2xl font-medium">Jairo Fernando Ramos G</h3>
        <p class="mt-2 text-lg font-bold text-[var(--sec)]">
          {isSpanish
            ? "Líder de Producto y Arquitecto Full-Stack"
            : "Lead Product & Full-Stack Architect"}
        </p>
        <ul class="team-expertise mt-2 space-y-5 font-body">
          <li>
            <strong class="font-bold text-[#97CC04]">
              {isSpanish ? "Diseño de producto:" : "Product Design:"}
            </strong>{" "}
            <span>
              {isSpanish
                ? "Especialista en conceptualizar experiencias interactivas y MVPs en Figma con el sistema de diseño modular Stitch."
                : "Specialist in conceptualizing interactive experiences and MVPs in Figma using the Stitch modular design system."}
            </span>
          </li>
          <li>
            <strong class="font-bold text-[#97CC04]">
              {isSpanish
                ? "Ingeniería multiplataforma:"
                : "Cross-Platform Engineering:"}
            </strong>{" "}
            <span>
              {isSpanish
                ? "Arquitectura y despliegue nativo con Kotlin Multiplatform, Flutter, Dart y Swift."
                : "Architecture and native deployment with Kotlin Multiplatform, Flutter, Dart, and Swift."}
            </span>
          </li>
          <li>
            <strong class="font-bold text-[#97CC04]">
              {isSpanish ? "Estrategia de negocio:" : "Business Strategy:"}
            </strong>{" "}
            <span>
              {isSpanish
                ? "Integración robusta de datos con PostgreSQL y Supabase, junto con automatización avanzada con IA para abrir nuevas fuentes de ingresos empresariales."
                : "Robust data integration with PostgreSQL and Supabase, combined with advanced AI automation to unlock new corporate revenue streams."}
            </span>
          </li>
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  .team-heading {
    max-width: 58rem;
    margin-inline: auto;
    font-size: clamp(2.25rem, 5vw, 3.75rem) !important;
    font-weight: 700 !important;
    letter-spacing: -0.04em;
    line-height: 1.1 !important;
  }

  .team-profile {
    max-width: 52rem;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
  }

  .team-expertise {
    color: var(--white-icon);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .profile-frame {
    padding: 0;
  }

  html.motion-enabled
    .team-photo.reveal-media:not(.is-visible)
    .team-photo__image {
    opacity: 0;
    transform: translateX(-3rem);
  }

  html.motion-enabled .team-photo.reveal-media.is-visible .team-photo__image {
    opacity: 1;
    transform: none;
  }

  html.motion-enabled .team-photo__image {
    transition:
      opacity 850ms ease,
      transform 850ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (max-width: 767px) {
    .team-profile {
      grid-template-columns: minmax(0, 1fr);
    }

    .team-profile__content {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-photo__image {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
