---

import { defaultLang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale === "es" ? "es" : defaultLang;
const t = useTranslations(lang);
const allowsMultipleExpanded = false;

const capabilities = [
  {
    title: t("core.items.0.title"),
    subtitle: t("core.items.0.subtitle"),
    iconName: "lan",
    content: [
      t("core.items.0.content.0"),
      t("core.items.0.content.1"),
      t("core.items.0.content.2"),
    ],
  },
  {
    title: t("core.items.1.title"),
    subtitle: t("core.items.1.subtitle"),
    iconName: "devices",
    content: [
      t("core.items.1.content.0"),
      t("core.items.1.content.1"),
      t("core.items.1.content.2"),
    ],
  },
  {
    title: t("core.items.2.title"),
    subtitle: t("core.items.2.subtitle"),
    iconName: "dashboard_customize",
    content: [
      t("core.items.2.content.0"),
      t("core.items.2.content.1"),
      t("core.items.2.content.2"),
    ],
  },
] as const;

function formatContent(text: string) {
  return text.split(/(\*\*.*?\*\*)/g).map((part) => ({
    text: part.startsWith("**") && part.endsWith("**")
      ? part.slice(2, -2)
      : part,
    bold: part.startsWith("**") && part.endsWith("**"),
  }));
}
---

<section class="w-full max-w-4xl mx-auto py-12 px-4 text-left">
  <h3 class="text-[var(--white)] text-3xl md:text-4xl font-semibold md:mb-6">
    {t("core.title")}
  </h3>
  <div
    class="capabilities-accordion w-full max-w-2xl mx-auto bg-neutral-900/40 border border-neutral-800 rounded-2xl overflow-hidden backdrop-blur-md"
    data-allows-multiple-expanded={String(allowsMultipleExpanded)}
  >
    <ul>
      {capabilities.map((item, index) => {
        const panelId = `capability-panel-${index + 1}`;
        const triggerId = `capability-trigger-${index + 1}`;

        return (
          <li class="group/item border-b border-neutral-800 last:border-b-0">
            <button
              id={triggerId}
              type="button"
              class="flex items-center gap-4 p-5 transition-all duration-200 hover:bg-neutral-800/40 text-left w-full"
              aria-expanded="false"
              aria-controls={panelId}
              data-accordion-trigger
            >
              <span
                class="material-symbols-outlined text-3xl text-[var(--sec)]"
                aria-hidden="true"
              >
                {item.iconName}
              </span>
              <span class="min-w-0">
                <span class="block font-medium text-lg leading-5 text-neutral-100">
                  {item.title}
                </span>
                <span class="block text-sm font-normal text-neutral-400 mt-1">
                  {item.subtitle}
                </span>
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="ml-auto h-5 w-5 shrink-0 text-neutral-500 transition-transform duration-300 ease-in-out group-aria-[expanded=true]/item:rotate-180"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div
              id={panelId}
              role="region"
              aria-labelledby={triggerId}
              aria-hidden="true"
              data-accordion-panel
              class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out aria-[hidden=false]:grid-rows-[1fr]"
            >
              <div class="min-h-0 overflow-hidden">
                <ul class="space-y-3 px-4 pb-4 pl-[4.5rem] text-sm leading-relaxed text-neutral-400">
                  {item.content.map((text) => (
                    <li class="list-disc">
                      {formatContent(text).map(({ text: part, bold }) =>
                        bold ? (
                          <strong class="font-semibold text-neutral-200">
                            {part}
                          </strong>
                        ) : (
                          part
                        ),
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  const accordion = document.querySelector<HTMLElement>(
    ".capabilities-accordion",
  );

  if (accordion) {
    const allowsMultipleExpanded =
      accordion.dataset.allowsMultipleExpanded === "true";
    const triggers = accordion.querySelectorAll<HTMLButtonElement>(
      "[data-accordion-trigger]",
    );

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const willExpand = trigger.getAttribute("aria-expanded") !== "true";

        if (!allowsMultipleExpanded && willExpand) {
          triggers.forEach((otherTrigger) => {
            otherTrigger.setAttribute("aria-expanded", "false");
            const otherPanelId = otherTrigger.getAttribute("aria-controls");
            const otherPanel = otherPanelId
              ? accordion.querySelector<HTMLElement>(`#${otherPanelId}`)
              : null;
            otherPanel?.setAttribute("aria-hidden", "true");
          });
        }

        trigger.setAttribute("aria-expanded", String(willExpand));
        const panelId = trigger.getAttribute("aria-controls");
        const panel = panelId
          ? accordion.querySelector<HTMLElement>(`#${panelId}`)
          : null;
        panel?.setAttribute("aria-hidden", String(!willExpand));
      });
    });
  }
</script>

<style>
  .material-symbols-outlined {
    font-family: "Material Symbols Outlined";
    font-weight: normal;
    font-style: normal;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    font-feature-settings: "liga";
    -webkit-font-feature-settings: "liga";
    -webkit-font-smoothing: antialiased;
  }
</style>
